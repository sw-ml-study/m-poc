# The Visual face of the sigmoid neuron (the one-neuron face with a σ box and an S-shaped fit), as a line scene built from the trace: MLPL owns the geometry, the page only projects it. Three panels side by side on the z = 0 plane. Left, the dataflow of the equation as labelled boxes (x, w → × → + ← b → ŷ; ŷ, y → − → ² → L) with the two gradient paths routed back from L to w and b. Middle, the data: the four points, the line the neuron fits at this epoch, and each point's residual. Right, parameter space: the path (w, b) has taken so far, the current point, and the update arrow whose legs are η times the two gradients. Every edge and label carries a symbol id of the equation record, so focus on a token finds its counterpart here. Coordinates are scene units, roughly 16 wide by 9 high.
include "../../lib/rosetta/scene.mlpl";
include "equation.mlpl";

def u:sg_palette() {
  "The RGBA colors of the face: one per kind of thing drawn.";
  {structure: [0.78, 0.8, 0.88, 1], param: [0.4, 0.85, 0.95, 1], flow: [0.55, 0.58, 0.68, 1], grad: [1, 0.6, 0.25, 1], data: [0.95, 0.85, 0.4, 1], fit: [0.4, 0.85, 0.95, 1], residual: [0.95, 0.5, 0.45, 1], path: [0.72, 0.58, 0.95, 1]}
}

def u:sg_points(xs, ys) {
  "Points on the z = 0 plane from parallel x and y vectors, as a [k, 3] array.";
  k = len(xs);
  reshape(flatten(transpose(reshape(concat(concat(xs, ys), fill([k], 0)), [3, k]))), [k, 3])
}

def u:sg_segment(scene, from_x, from_y, to_x, to_y, id, color) {
  "One straight edge between two points on the plane.";
  u:rs_scene_polyline(scene, u:sg_points([from_x, to_x], [from_y, to_y]), 0, id, color)
}

def u:sg_diamond(scene, cx, cy, r, id, color) {
  "A small closed diamond marking a point.";
  u:rs_scene_polyline(scene, u:sg_points([cx - r, cx, cx + r, cx], [cy, cy + r, cy, cy - r]), 1, id, color)
}

def u:sg_box(scene, cx, cy, id, text, color) {
  "A labelled box of the dataflow: a closed rectangle 0.9 wide and 0.6 high around its center, and the label at the center.";
  scene = u:rs_scene_polyline(scene, u:sg_points([cx - 0.45, cx + 0.45, cx + 0.45, cx - 0.45], [cy - 0.3, cy - 0.3, cy + 0.3, cy + 0.3]), 1, id, color)?;
  u:rs_scene_label(scene, [cx, cy, 0], id, text)
}

def u:sg_dataflow(scene) {
  "The structure panel: the equation as boxes and the edges the values flow along, each edge carrying the id of the value it carries; the gradient paths carry the gradient ids.";
  c = u:sg_palette();
  scene = u:sg_box(scene, 1, 8.4, "x", "x", c.structure)?;
  scene = u:sg_box(scene, 1, 7, "w", "w", c.param)?;
  scene = u:sg_box(scene, 1, 5.6, "b", "b", c.param)?;
  scene = u:sg_box(scene, 2.8, 7.7, "mul", "×", c.structure)?;
  scene = u:sg_box(scene, 4.0, 6.65, "add", "+", c.structure)?;
  scene = u:sg_box(scene, 5.3, 6.65, "sigma", "σ", c.structure)?;
  scene = u:sg_box(scene, 6.4, 6.65, "yhat", "ŷ", c.structure)?;
  scene = u:sg_box(scene, 4.6, 4.4, "y", "y", c.structure)?;
  scene = u:sg_box(scene, 6.4, 4.4, "sub", "−", c.structure)?;
  scene = u:sg_box(scene, 6.4, 2.9, "sq", "²", c.structure)?;
  scene = u:sg_box(scene, 6.4, 1.4, "L", "L", c.structure)?;
  scene = u:sg_segment(scene, 1.45, 8.4, 2.35, 7.7, "x", c.flow)?;
  scene = u:sg_segment(scene, 1.45, 7, 2.35, 7.7, "w", c.flow)?;
  scene = u:sg_segment(scene, 3.25, 7.7, 3.55, 6.65, "mul", c.flow)?;
  scene = u:sg_segment(scene, 1.45, 5.6, 3.55, 6.65, "b", c.flow)?;
  scene = u:sg_segment(scene, 4.45, 6.65, 4.85, 6.65, "add", c.flow)?;
  scene = u:sg_segment(scene, 5.75, 6.65, 5.95, 6.65, "sigma", c.flow)?;
  scene = u:sg_segment(scene, 6.4, 6.35, 6.4, 4.7, "yhat", c.flow)?;
  scene = u:sg_segment(scene, 5.05, 4.4, 5.95, 4.4, "y", c.flow)?;
  scene = u:sg_segment(scene, 6.4, 4.1, 6.4, 3.2, "sub", c.flow)?;
  scene = u:sg_segment(scene, 6.4, 2.6, 6.4, 1.7, "sq", c.flow)?;
  scene = u:rs_scene_polyline(scene, u:sg_points([5.95, 0.3, 0.3, 0.55], [1.55, 1.55, 7, 7]), 0, "grad_w", c.grad)?;
  scene = u:rs_scene_polyline(scene, u:sg_points([5.95, 0.75, 0.75], [1.25, 1.25, 5.3]), 0, "grad_b", c.grad)?;
  u:rs_scene_label(scene, [0.52, 3.3, 0], "eta", "η")
}

def u:sg_plot_x(x) {
  "Data x to scene x in the data panel.";
  10.3 + x * 1.1
}

def u:sg_plot_y(y) {
  "Data y to scene y in the data panel: 0 at the axis, 1 near the top.";
  1.4 + y * 6.2
}

def u:sg_data_panel(scene, trace, t) {
  "The data panel at epoch t: axes with the level 1 marked, the four points, the S-shaped fit σ(wx + b) sampled across the panel, and a residual from every point to the fit.";
  c = u:sg_palette();
  xs = trace.constants.x;
  ys = trace.constants.y;
  k = len(xs);
  yhat = take(reshape(trace.channels.yhat.values, trace.channels.yhat.shape), 0, t);
  scene = u:sg_segment(scene, u:sg_plot_x(-1.9), u:sg_plot_y(0), u:sg_plot_x(1.9), u:sg_plot_y(0), "x", c.structure)?;
  scene = u:sg_segment(scene, u:sg_plot_x(0), u:sg_plot_y(0), u:sg_plot_x(0), u:sg_plot_y(1.12), "y", c.structure)?;
  scene = u:sg_segment(scene, u:sg_plot_x(-1.9), u:sg_plot_y(1), u:sg_plot_x(1.9), u:sg_plot_y(1), "y", c.flow)?;
  scene = u:rs_scene_label(scene, [u:sg_plot_x(2.15), u:sg_plot_y(0), 0], "x", "x")?;
  scene = u:rs_scene_label(scene, [u:sg_plot_x(0), u:sg_plot_y(1.2), 0], "y", "y")?;
  index = 0;
  while lt(index, k) {
    px = u:sg_plot_x(take(xs, 0, index));
    scene = u:sg_diamond(scene, px, u:sg_plot_y(take(ys, 0, index)), 0.12, "y", c.data)?;
    scene = u:sg_segment(scene, px, u:sg_plot_y(take(ys, 0, index)), px, u:sg_plot_y(take(yhat, 0, index)), "sub", c.residual)?;
    index = index + 1
  };
  samples = range(25) / 24 * 3.8 - 1.9;
  w = take(trace.channels.w, 0, t);
  b = take(trace.channels.b, 0, t);
  curve = sigmoid(w * samples + b);
  u:rs_scene_polyline(scene, u:sg_points(u:sg_plot_x(samples), u:sg_plot_y(curve)), 0, "yhat", c.fit)
}

def u:sg_param_w(w) {
  "Parameter w to scene x in the parameter panel.";
  14.2 + w * 0.5
}

def u:sg_param_b(b) {
  "Parameter b to scene y in the parameter panel: zero at mid height.";
  4.6 + b * 2.0
}

def u:sg_param_panel(scene, trace, t) {
  "The parameter panel at epoch t: axes, the path (w, b) has taken up to t (later points folded onto the current one so every frame has the same vertices), the current point, and the update arrow: a leg of −η ∂L/∂w, a leg of −η ∂L/∂b, and the resultant with its head.";
  c = u:sg_palette();
  ws = trace.channels.w;
  bs = trace.channels.b;
  n = len(ws);
  eta = trace.constants.eta;
  wt = take(ws, 0, t);
  bt = take(bs, 0, t);
  seen = range(n) <= t;
  scene = u:sg_segment(scene, u:sg_param_w(0), u:sg_param_b(0), u:sg_param_w(4.2), u:sg_param_b(0), "w", c.param)?;
  scene = u:sg_segment(scene, u:sg_param_w(0), u:sg_param_b(-1.6), u:sg_param_w(0), u:sg_param_b(1.6), "b", c.param)?;
  scene = u:rs_scene_label(scene, [u:sg_param_w(4.5), u:sg_param_b(0), 0], "w", "w")?;
  scene = u:rs_scene_label(scene, [u:sg_param_w(0), u:sg_param_b(1.8), 0], "b", "b")?;
  scene = u:rs_scene_polyline(scene, u:sg_points(u:sg_param_w(ws * seen + wt * (1 - seen)), u:sg_param_b(bs * seen + bt * (1 - seen))), 0, "assign", c.path)?;
  px = u:sg_param_w(wt);
  py = u:sg_param_b(bt);
  nx = u:sg_param_w(wt - eta * take(trace.channels.grad_w, 0, t));
  ny = u:sg_param_b(bt - eta * take(trace.channels.grad_b, 0, t));
  scene = u:sg_diamond(scene, px, py, 0.12, "assign", c.path)?;
  scene = u:sg_segment(scene, px, py, nx, py, "grad_w", c.grad)?;
  scene = u:sg_segment(scene, nx, py, nx, ny, "grad_b", c.grad)?;
  scene = u:sg_segment(scene, px, py, nx, ny, "assign", c.path)?;
  dx = nx - px;
  dy = ny - py;
  length = sqrt(dx * dx + dy * dy);
  back = if lt(length, 0.000001) {
    0
  } else {
    0.2 / length
  };
  side = back / 2;
  u:rs_scene_polyline(scene, u:sg_points([nx - dx * back - dy * side, nx, nx - dx * back + dy * side], [ny - dy * back + dx * side, ny, ny - dy * back - dx * side]), 0, "assign", c.path)
}

def u:sg_panels(scene) {
  "Name the three panels and the gradient paths for the page's legend and callouts: what each region shows and why.";
  c = u:sg_palette();
  scene = u:rs_scene_panel(scene, "dataflow", "Dataflow", "The equation as boxes: values flow left to right from x, w and b through ×, + and the squashing σ to ŷ, then with y through − and ² to the loss L. Click a box to focus that symbol everywhere.", [0, 0.8, 7.2, 9], c.structure)?;
  scene = u:rs_scene_panel(scene, "gradients", "Gradient paths", "The orange lines carry ∂L/∂w and ∂L/∂b back from L to w and b; η beside them is the step size that scales them into the update.", [0.1, 1, 1, 7.3], c.grad)?;
  scene = u:rs_scene_panel(scene, "data", "Data", "The four training points as diamonds (targets 0 and 1, the level 1 marked), and the S-shaped fit σ(wx + b) at this epoch; each red stroke is a residual y − ŷ. Watch the curve steepen between the two groups of points.", [7.9, 0.8, 13.0, 9], c.fit)?;
  u:rs_scene_panel(scene, "parameters", "Parameters", "Parameter space: the path (w, b) has taken so far, the current point, and the arrow to next epoch's (w, b); its legs are −η ∂L/∂w and −η ∂L/∂b, the two scaled gradients.", [13.2, 0.8, 16.6, 9], c.path)
}

def u:sg_visual(trace, t) {
  "The whole Visual face at epoch t of a parsed trace record.";
  scene = u:rs_scene_new(trace.axis.name);
  scene = u:sg_dataflow(scene)?;
  scene = u:sg_data_panel(scene, trace, t)?;
  scene = u:sg_param_panel(scene, trace, t)?;
  u:sg_panels(scene)
}

def u:sg_scene(trace) {
  "The Visual face with one frame per epoch of the trace: the geometry at epoch zero, then every epoch's positions.";
  scene = u:sg_visual(trace, 0)?;
  t = 0;
  while lt(t, trace.axis.count) {
    frame = u:sg_visual(trace, t)?;
    scene = u:rs_scene_frame(scene, reshape(frame.positions, [frame.vertex_count, 3]))?;
    t = t + 1
  };
  ok(scene)
}

def u:sg_read_trace(path) {
  "The trace record from its fixture.";
  parse_json(read_text(path)?)
}
