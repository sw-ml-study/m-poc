# Build the Visual face of attention from the committed trace and write it: fixtures/attention/scene.json by default, or the path given as the script's argument. The JSON written is also printed; the reg-rs baseline rosetta_attention_scene pins it.
include "visual.mlpl";

at_path = if gt(list_len(args()), 0) {
  unwrap(list_get(args(), 0))
} else {
  "fixtures/attention/scene.json"
};

trace = unwrap(u:at_read_trace("fixtures/attention/trace.json"));
scene = unwrap(u:at_scene(trace));
text = unwrap(u:rs_write_json(at_path, unwrap(u:rs_scene_export(scene, 4))));
print(text);
str_concat("wrote ", at_path)
