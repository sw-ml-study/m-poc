# The sigmoid stone: the loop trains through sigmoid for real (grad against the closed-form gradient with the sigmoid derivative at every epoch, the update rule, ŷ = σ(wx + b) in every row), the loss falls monotonically to a low value, the record is fully documented with a σ symbol on both faces, the Visual face's ids are symbols, and the committed fixtures are what the programs emit.
include "lib/rosetta/faces.mlpl";
include "demos/sigmoid/neuron.mlpl";
include "demos/sigmoid/visual.mlpl";

def u:t_sg_rows() {
  "The rows the fixture is built from: the same learning rate and epoch count as train.mlpl.";
  u:sg_train(2.0, 40)
}

def u:t_sg_max_abs(v) {
  "The largest absolute value in an array.";
  reduce(:max, abs(v))
}

def u:t_sg_unknown(ir, ids) {
  "The first id in a string list that is not a symbol of the record, or the empty string.";
  index = 0;
  unknown = "";
  while lt(index, list_len(ids)) {
    id = unwrap(list_get(ids, index));
    if eq(u:rs_ir_symbol_index(ir, id), -1) {
      unknown = id
    };
    index = index + 1
  };
  unknown
}

@test {name: "the loss never rises and ends low, and the fit steepens", tags: ["sigmoid", "trace", "loss"]}
def u:test_sg_loss() {
  "Gradient descent through sigmoid on a separable set: monotone, and the weight grows so the curve steepens.";
  rows = u:t_sg_rows();
  n = len(rows.L);
  step = (rotate(rows.L, 1, 0) - rows.L) * (range(n) < n - 1);
  u:assert_eq(reduce(:max, step) <= 0, 1, "loss is non-increasing at every epoch")?;
  u:assert_eq(take(rows.L, 0, 0), 0.25, "the untrained loss: every prediction is one half")?;
  u:assert_lt(take(rows.L, 0, n - 1), 0.02, "the trained loss is low")?;
  u:assert_gt(take(rows.w, 0, n - 1), 2.5, "the weight grew: a steep S")
}

@test {name: "grad through sigmoid agrees with the closed form at every epoch", tags: ["sigmoid", "trace", "grad"]}
def u:test_sg_gradients() {
  "∂L/∂w = mean(2(ŷ − y) ŷ(1 − ŷ) x) and ∂L/∂b = mean(2(ŷ − y) ŷ(1 − ŷ)), by hand from the recorded ŷ.";
  rows = u:t_sg_rows();
  residual = rows.yhat - reshape(rows.y, [1, 4]);
  slope = rows.yhat * (1 - rows.yhat);
  by_hand_w = reduce_add(2 * residual * slope * reshape(rows.x, [1, 4]), 1) / 4;
  by_hand_b = reduce_add(2 * residual * slope, 1) / 4;
  u:assert_lt(u:t_sg_max_abs(by_hand_w - rows.grad_w), 0.000000001, "gradient with respect to w")?;
  u:assert_lt(u:t_sg_max_abs(by_hand_b - rows.grad_b), 0.000000001, "gradient with respect to b")?;
  predicted = sigmoid(reshape(rows.w, [41, 1]) * reshape(rows.x, [1, 4]) + reshape(rows.b, [41, 1]));
  u:assert_lt(u:t_sg_max_abs(predicted - rows.yhat), 0.000000001, "ŷ = σ(wx + b) in every row")
}

@test {name: "the sigmoid record is fully documented, σ is on both faces, and the fixtures are fresh", tags: ["sigmoid", "docs", "faces", "fixture"]}
def u:test_sg_record() {
  "Eighteen symbols: the neuron's seventeen plus sigma.";
  ir = unwrap(u:sg_equation());
  u:assert_eq(ir.symbol_count, 18, "eighteen symbols")?;
  u:assert_text_eq(u:rs_ir_undocumented(ir), "", "every symbol")?;
  u:assert_text_eq(u:rs_ir_undocumented_line(ir), "", "every line")?;
  u:assert_text_eq(u:rs_ir_undocumented_face(ir), "", "every face")?;
  u:assert_eq(u:rs_face_uses(ir.faces.math, "sigma") * u:rs_face_uses(ir.faces.m, "sigma"), 1, "σ on both faces")?;
  u:assert_text_eq(unwrap(list_get(str_split(u:rs_ir_math_text(ir), "\n"), 0)), "ŷ = σ(w⁢x + b)", "the first Math line")?;
  trace = u:sg_trace(u:t_sg_rows(), 6);
  u:assert_eq(str_eq(read_text("fixtures/sigmoid/trace.json")?, unwrap(u:rs_json(trace))), 1, "trace fresh")?;
  u:assert_eq(str_eq(read_text("fixtures/sigmoid/faces/math.svg")?, unwrap(u:rs_face_svg(ir, "math"))), 1, "math.svg fresh")?;
  parsed = unwrap(u:sg_read_trace("fixtures/sigmoid/trace.json"));
  out = unwrap(u:rs_scene_export(unwrap(u:sg_visual(parsed, 5)), 4));
  u:assert_text_eq(u:t_sg_unknown(ir, out.ids), "", "edge ids are symbols")?;
  u:assert_text_eq(u:t_sg_unknown(ir, out.labels.ids), "", "label ids are symbols")?;
  full = unwrap(u:rs_scene_export(unwrap(u:sg_scene(parsed)), 4));
  u:assert_eq(full.frames.count, 41, "one frame per epoch")?;
  u:assert_eq(str_eq(read_text("fixtures/sigmoid/scene.json")?, unwrap(u:rs_json(full))), 1, "scene.json fresh")
}

u:run_registered_tests()
