# The Trace face of the cnn stone: the output cell over the positions, read from the committed trace and drawn by lib/rosetta/timeline.mlpl with a marker at the current step. Written to fixtures/cnn/trace-scene.json by default, or the path given as the script's argument; printed too, for the reg-rs baseline rosetta_cnn_trace_scene.
include "../../lib/rosetta/timeline.mlpl";

ts_path = if gt(list_len(args()), 0) {
  unwrap(list_get(args(), 0))
} else {
  "fixtures/cnn/trace-scene.json"
};

trace = unwrap(parse_json(unwrap(read_text("fixtures/cnn/trace.json"))));
scene = unwrap(u:rs_timeline_scene(trace.axis.name, trace.channels.sum, "sum", "+/", "the output cell over the positions", "The time axis itself: the value of the output cell computed at each position as the window slides over the input in row-major order; the marker is the position shown on the other faces.", [0.72, 0.58, 0.95, 1]));
text = unwrap(u:rs_write_json(ts_path, unwrap(u:rs_scene_export(scene, 4))));
print(text);
str_concat("wrote ", ts_path)
