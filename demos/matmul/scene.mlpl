# Build the Visual face of the matrix product from the committed trace and write it: fixtures/matmul/scene.json by default, or the path given as the script's argument. The JSON written is also printed; the reg-rs baseline rosetta_matmul_scene pins it.
include "visual.mlpl";

mm_path = if gt(list_len(args()), 0) {
  unwrap(list_get(args(), 0))
} else {
  "fixtures/matmul/scene.json"
};

trace = unwrap(u:mm_read_trace("fixtures/matmul/trace.json"));
scene = unwrap(u:mm_scene(trace));
text = unwrap(u:rs_write_json(mm_path, unwrap(u:rs_scene_export(scene, 4))));
print(text);
str_concat("wrote ", mm_path)
