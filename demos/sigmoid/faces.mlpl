# Render the sigmoid neuron's Math and proposed-M faces to SVG and write them, with the equation record itself as JSON: fixtures/sigmoid/faces/math.svg, m.svg and equation.json by default, or into the directory given as the script's argument (scripts/check-fixtures uses that). Both documents are also printed; the reg-rs baseline rosetta_sigmoid_faces pins them. The glyphs are laid out by sw-MLPL's equation renderer; this repository only tags the tokens.
include "../../lib/rosetta/faces.mlpl";
include "../../lib/rosetta/emit.mlpl";
include "equation.mlpl";

sg_dir = if gt(list_len(args()), 0) {
  unwrap(list_get(args(), 0))
} else {
  "fixtures/sigmoid/faces"
};

ir = unwrap(u:sg_equation());
unwrap(make_dir(sg_dir));
math = unwrap(u:rs_face_svg(ir, "math"));
m = unwrap(u:rs_face_svg(ir, "m"));
unwrap(write_atomic(str_concat(sg_dir, "/math.svg"), math));
unwrap(write_atomic(str_concat(sg_dir, "/m.svg"), m));
unwrap(u:rs_write_json(str_concat(sg_dir, "/equation.json"), unwrap(u:rs_ir_export(ir))));
print("MATH");
print(math);
print("M (proposed)");
print(m);
str_concat("wrote ", sg_dir)
