#!/bin/sh
# The committed pages/data/ is exactly what scripts/build-site copies from
# the fixtures, so the published stone replays the reviewed numbers.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

for pair in \
    fixtures/one-neuron/trace.json:pages/data/trace.json \
    fixtures/one-neuron/scene.json:pages/data/scene.json \
    fixtures/one-neuron/faces/math.svg:pages/data/faces/math.svg \
    fixtures/one-neuron/faces/m.svg:pages/data/faces/m.svg \
    fixtures/one-neuron/faces/equation.json:pages/data/faces/equation.json
do
    src=${pair%%:*}
    dst=${pair#*:}
    if ! cmp -s "$src" "$dst"; then
        echo "stale site data: $dst differs from $src (run: ./scripts/build-site)" >&2
        exit 1
    fi
done

for page in pages/index.html pages/style.css pages/rosetta.js; do
    [ -f "$page" ] || { echo "missing page file: $page" >&2; exit 1; }
done

echo "PASS site data matches fixtures"
