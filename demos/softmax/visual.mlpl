# The Visual face of softmax, as a line scene built from the trace. Left, the dataflow: Z into * (exp), into ÷, with +/ feeding the divisor, into P. Right, three rows of bars, one bar per entry: the scores divided by the temperature, their exponentials (each row scaled to its tallest bar, so the row shows who dominates), and the probabilities on a 0 to 1 scale that always add up to one. Every edge and label carries a symbol id of the equation record. Coordinates are scene units, roughly 16 wide by 9 high.
include "../../lib/rosetta/scene.mlpl";
include "equation.mlpl";

def u:sm_palette() {
  "The RGBA colours of the face.";
  {structure: [0.78, 0.8, 0.88, 1], score: [0.4, 0.85, 0.95, 1], expo: [0.95, 0.85, 0.4, 1], prob: [0.72, 0.58, 0.95, 1], flow: [0.55, 0.58, 0.68, 1], lit: [1, 0.6, 0.25, 1]}
}

def u:sm_dataflow(scene) {
  "The structure panel: the scores into the exponential, into the divide, with the sum of the exponentials as the divisor, into the probabilities.";
  c = u:sm_palette();
  scene = u:rs_scene_box(scene, 1, 5.5, 0.9, 0.6, "z", "z", c.score)?;
  scene = u:rs_scene_box(scene, 3, 5.5, 0.9, 0.6, "exp", "*", c.structure)?;
  scene = u:rs_scene_box(scene, 5, 5.5, 0.9, 0.6, "div", "÷", c.structure)?;
  scene = u:rs_scene_box(scene, 5, 3.5, 0.9, 0.6, "sum", "+/", c.structure)?;
  scene = u:rs_scene_box(scene, 7, 5.5, 0.9, 0.6, "p", "σ", c.prob)?;
  scene = u:rs_scene_segment(scene, 1.45, 5.5, 2.55, 5.5, "z", c.flow)?;
  scene = u:rs_scene_segment(scene, 3.45, 5.5, 4.55, 5.5, "exp", c.flow)?;
  scene = u:rs_scene_segment(scene, 3.3, 5.2, 4.55, 3.5, "exp", c.flow)?;
  scene = u:rs_scene_segment(scene, 5, 3.8, 5, 5.2, "sum", c.flow)?;
  u:rs_scene_segment(scene, 5.45, 5.5, 6.55, 5.5, "div", c.flow)
}

def u:sm_bar_x(k) {
  "Scene x of the k-th bar.";
  9.2 + k * 1.3
}

def u:sm_bars(scene, values, base_y, height, top, id, color) {
  "A row of vertical bars from a baseline, values scaled so that top maps to height; negative values go down.";
  index = 0;
  n = len(values);
  while lt(index, n) {
    x = u:sm_bar_x(index);
    v = take(values, 0, index) / top * height;
    scene = u:rs_scene_rect(scene, x - 0.4, base_y, x + 0.4, base_y + v, id, color)?;
    index = index + 1
  };
  ok(scene)
}

def u:sm_rows(scene, trace, t) {
  "The bars panel at step t: scores over temperature, exponentials, probabilities, with baselines and row names.";
  c = u:sm_palette();
  n = trace.constants.n;
  scaled = take(reshape(trace.channels.z.values, trace.channels.z.shape), 0, t);
  exps = take(reshape(trace.channels.exp.values, trace.channels.exp.shape), 0, t);
  probs = take(reshape(trace.channels.p.values, trace.channels.p.shape), 0, t);
  all_scaled = trace.channels.z.values;
  top_scaled = reduce(:max, abs(all_scaled)) + 0.0001;
  right = u:sm_bar_x(n - 1) + 0.6;
  left = u:sm_bar_x(0) - 0.6;
  scene = u:rs_scene_label(scene, [left - 0.6, 7.0, 0], "z", "z")?;
  scene = u:rs_scene_segment(scene, left, 7.0, right, 7.0, "z", c.structure)?;
  scene = u:sm_bars(scene, scaled, 7.0, 1.4, top_scaled, "z", c.score)?;
  scene = u:rs_scene_label(scene, [left - 0.6, 3.9, 0], "exp", "e")?;
  scene = u:rs_scene_segment(scene, left, 3.9, right, 3.9, "exp", c.structure)?;
  scene = u:sm_bars(scene, exps, 3.9, 1.5, reduce(:max, exps) + 0.0001, "exp", c.expo)?;
  scene = u:rs_scene_label(scene, [left - 0.6, 1.2, 0], "p", "σ")?;
  scene = u:rs_scene_segment(scene, left, 1.2, right, 1.2, "p", c.structure)?;
  scene = u:rs_scene_segment(scene, left, 2.7, right, 2.7, "one", c.flow)?;
  scene = u:rs_scene_label(scene, [right + 0.4, 2.7, 0], "one", "1")?;
  scene = u:sm_bars(scene, probs, 1.2, 1.5, 1, "p", c.prob)?;
  scene = u:rs_scene_label(scene, [u:sm_bar_x(0), 0.7, 0], "i", "i")?;
  u:rs_scene_label(scene, [u:sm_bar_x(n - 1), 0.7, 0], "n", "n")
}

def u:sm_panels(scene) {
  "Name the two panels for the page's legend and callouts.";
  c = u:sm_palette();
  scene = u:rs_scene_panel(scene, "dataflow", "Dataflow", "The scores flow into the exponential, whose results go two ways: into the divide, and into the sum that becomes the divisor; the divide's output is the probabilities. Click a box to focus that symbol everywhere.", [0.3, 2.8, 7.7, 6.4], c.structure)?;
  u:rs_scene_panel(scene, "bars", "Bars", "Top: the five scores divided by the temperature at this step (the scale is fixed, so they spread out as the temperature falls). Middle: their exponentials, scaled to the tallest, so the row shows which entry dominates. Bottom: the probabilities, on a 0 to 1 scale; they always add up to one.", [7.8, 0.3, 16.4, 8.8], c.prob)
}

def u:sm_visual(trace, t) {
  "The whole Visual face at step t of a parsed trace record.";
  scene = u:rs_scene_new(trace.axis.name);
  scene = u:sm_dataflow(scene)?;
  scene = u:sm_rows(scene, trace, t)?;
  u:sm_panels(scene)
}

def u:sm_scene(trace) {
  "The Visual face with one frame per step of the trace.";
  scene = u:sm_visual(trace, 0)?;
  t = 0;
  while lt(t, trace.axis.count) {
    frame = u:sm_visual(trace, t)?;
    scene = u:rs_scene_frame(scene, reshape(frame.positions, [frame.vertex_count, 3]))?;
    t = t + 1
  };
  ok(scene)
}

def u:sm_read_trace(path) {
  "The trace record from its fixture.";
  parse_json(read_text(path)?)
}
