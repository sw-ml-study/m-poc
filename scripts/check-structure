#!/bin/sh
# The directory contract from docs/plan.md: the files every later step assumes exist.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

for path in \
    README.md \
    CLAUDE.md \
    AGENTS.md \
    COPYRIGHT \
    LICENSE \
    justfile \
    mlplunit.conf \
    docs/plan.md \
    docs/research.txt \
    tests/test_smoke.mlpl \
    lib/rosetta/ir.mlpl \
    demos/one-neuron/equation.mlpl \
    demos/one-neuron/show.mlpl \
    tests/test_equation_ir.mlpl \
    tests/reg/rosetta_one_neuron_equation.rgt \
    lib/rosetta/emit.mlpl \
    demos/one-neuron/neuron.mlpl \
    demos/one-neuron/train.mlpl \
    fixtures/one-neuron/trace.json \
    tests/test_one_neuron_trace.mlpl \
    tests/reg/rosetta_one_neuron_trace.rgt \
    docs/trace.md \
    lib/rosetta/faces.mlpl \
    lib/rosetta/scene.mlpl \
    demos/one-neuron/visual.mlpl \
    demos/one-neuron/scene.mlpl \
    demos/one-neuron/faces.mlpl \
    fixtures/one-neuron/scene.json \
    fixtures/one-neuron/faces/math.svg \
    fixtures/one-neuron/faces/m.svg \
    tests/test_faces.mlpl \
    tests/test_scene.mlpl \
    tests/test_one_neuron_visual.mlpl \
    tests/reg/rosetta_one_neuron_faces.rgt \
    tests/reg/rosetta_one_neuron_scene.rgt \
    docs/scene.md \
    docs/stones.md \
    demos/stones.mlpl \
    fixtures/stones.json \
    pages/data/stones.json \
    tests/test_stones.mlpl \
    demos/dot-product/equation.mlpl \
    demos/dot-product/dot.mlpl \
    demos/dot-product/train.mlpl \
    demos/dot-product/faces.mlpl \
    demos/dot-product/visual.mlpl \
    demos/dot-product/scene.mlpl \
    fixtures/dot-product/trace.json \
    fixtures/dot-product/scene.json \
    fixtures/dot-product/faces/equation.json \
    tests/test_dot_product.mlpl \
    demos/matmul/equation.mlpl \
    demos/matmul/mm.mlpl \
    demos/matmul/train.mlpl \
    demos/matmul/faces.mlpl \
    demos/matmul/visual.mlpl \
    demos/matmul/scene.mlpl \
    fixtures/matmul/trace.json \
    fixtures/matmul/scene.json \
    tests/test_matmul.mlpl \
    tests/reg/rosetta_matmul_trace.rgt \
    tests/reg/rosetta_matmul_faces.rgt \
    tests/reg/rosetta_matmul_scene.rgt \
    tests/reg/rosetta_dot_product_trace.rgt \
    tests/reg/rosetta_dot_product_faces.rgt \
    tests/reg/rosetta_dot_product_scene.rgt \
    tests/reg/rosetta_stones.rgt \
    tests/sums_record.mlpl \
    tests/render_sums.mlpl \
    tests/reg/rosetta_sums_faces.rgt \
    fixtures/one-neuron/faces/equation.json \
    scripts/build-site \
    scripts/check-site \
    pages/style.css \
    pages/rosetta.js \
    pages/data/one-neuron/trace.json \
    pages/data/one-neuron/scene.json \
    pages/data/one-neuron/faces/math.svg \
    pages/data/one-neuron/faces/m.svg \
    pages/data/one-neuron/faces/equation.json \
    pages/index.html \
    .github/workflows/pages.yml
do
    [ -f "$repo_root/$path" ] || { echo "missing required file: $path" >&2; exit 1; }
done

for dir in lib/rosetta demos/one-neuron demos/dot-product demos/matmul fixtures fixtures/one-neuron fixtures/dot-product fixtures/matmul pages tests tests/reg scripts docs; do
    [ -d "$repo_root/$dir" ] || { echo "missing required directory: $dir" >&2; exit 1; }
done

echo "PASS repository structure"
