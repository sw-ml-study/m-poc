# The Adam stone: every row of the trace obeys the update rules (moments, corrections, step), the final parameters equal sw-MLPL's adam builtin run the same way, the loss falls, the comparison path (the first stone's trace) starts at the same point at the same rate, the trace is keyed by the record's symbols, the record's docs are complete with the tuple symbols on the M face only, the Visual face's ids are symbols, and the committed fixtures are what the programs emit.
include "lib/rosetta/faces.mlpl";
include "demos/adam/compute.mlpl";
include "demos/adam/visual.mlpl";

ad_t_eta = 0.1;
ad_t_beta1 = 0.9;
ad_t_beta2 = 0.999;
ad_t_eps = 0.00000001;

def u:t_ad_unknown(ir, ids) {
  "The first id in a string list that is not a symbol of the record, or the empty string.";
  index = 0;
  unknown = "";
  while lt(index, list_len(ids)) {
    id = unwrap(list_get(ids, index));
    if eq(u:rs_ir_symbol_index(ir, id), -1) {
      unknown = id
    };
    index = index + 1
  };
  unknown
}

@test {name: "every row obeys the Adam rules, the run ends where the adam builtin ends, the loss falls, and the plain path shares the start", tags: ["adam", "trace"]}
def u:test_ad_rules() {
  "Row t's moments come from row t−1's moments and gradient, its corrections divide by 1 − βᵗ, its parameters are row t−1's moved by the corrected step; thirty steps of the builtin land on the same parameters.";
  rows = u:ad_train(ad_t_eta, ad_t_beta1, ad_t_beta2, ad_t_eps, 30);
  t = 1;
  while lt(t, 31) {
    g_prev = take(rows.g, 0, t - 1);
    m_prev = take(rows.m, 0, t - 1);
    v_prev = take(rows.v, 0, t - 1);
    m_t = take(rows.m, 0, t);
    v_t = take(rows.v, 0, t);
    u:assert_lt(reduce(:max, abs(m_t - (ad_t_beta1 * m_prev + (1 - ad_t_beta1) * g_prev))), 0.000000001, "the first moment rule")?;
    u:assert_lt(reduce(:max, abs(v_t - (ad_t_beta2 * v_prev + (1 - ad_t_beta2) * g_prev * g_prev))), 0.000000001, "the second moment rule")?;
    u:assert_lt(reduce(:max, abs(take(rows.mhat, 0, t) - m_t / (1 - pow(ad_t_beta1, t)))), 0.000000001, "the first correction")?;
    u:assert_lt(reduce(:max, abs(take(rows.vhat, 0, t) - v_t / (1 - pow(ad_t_beta2, t)))), 0.000000001, "the second correction")?;
    step = ad_t_eta * take(rows.mhat, 0, t) / (sqrt(take(rows.vhat, 0, t)) + ad_t_eps);
    u:assert_lt(abs(take(rows.w, 0, t) - (take(rows.w, 0, t - 1) - take(step, 0, 0))), 0.000000001, "the step for w")?;
    u:assert_lt(abs(take(rows.b, 0, t) - (take(rows.b, 0, t - 1) - take(step, 0, 1))), 0.000000001, "the step for b")?;
    t = t + 1
  };
  u:assert_eq(take(rows.mhat, 0, 0), [0, 0], "no correction before the first step")?;
  u:assert_lt(abs(take(rows.w, 0, 1) - ad_t_eta), 0.0000001, "the first step moves w by η, whatever the gradient")?;
  u:assert_lt(take(rows.L, 0, 30), take(rows.L, 0, 0) / 10, "the loss falls by more than ten times")?;
  u:on_reset();
  t = 0;
  while lt(t, 30) {
    adam(u:on_loss(), [on_w, on_b], ad_t_eta, ad_t_beta1, ad_t_beta2, ad_t_eps);
    t = t + 1
  };
  u:assert_lt(abs(take(on_w, 0, 0) - take(rows.w, 0, 30)) + abs(take(on_b, 0, 0) - take(rows.b, 0, 30)), 0.000000001, "thirty steps of the adam builtin land on the same parameters")?;
  plain = unwrap(u:ad_read_trace("fixtures/one-neuron/trace.json"));
  u:assert_eq(plain.constants.eta, ad_t_eta, "the plain path uses the same rate")?;
  u:assert_eq([take(plain.channels.w, 0, 0), take(plain.channels.b, 0, 0)], [0, 0], "the plain path starts at the same point")?;
  u:assert_eq(plain.axis.count, 31, "and runs the same number of epochs")
}

@test {name: "the trace is keyed by the record's symbols; the tuple symbols live on the M face; docs complete; fixtures fresh", tags: ["adam", "docs", "fixture"]}
def u:test_ad_record() {
  "Six lines per face; Θ and ↻ on the M face only, ∂ on the Math face only; every symbol, line and face documented; keys are symbols; fixtures byte for byte.";
  ir = unwrap(u:ad_equation());
  u:assert_text_eq(ir.title, "Adam", "title")?;
  u:assert_text_eq(u:rs_ir_undocumented(ir), "", "every symbol")?;
  u:assert_text_eq(u:rs_ir_undocumented_line(ir), "", "every line")?;
  u:assert_text_eq(u:rs_ir_undocumented_face(ir), "", "every face")?;
  u:assert_text_eq(u:rs_ir_math_text(ir), "g = ∂L/∂w\nm ← β₁⁢m + (1 − β₁)⁢g\nv ← β₂⁢v + (1 − β₂)⁢g²\nm̂ = m/(1 − β₁^{t}), v̂ = v/(1 − β₂^{t})\nw ← w − η⁢m̂/(√v̂ + ε)\nb ← b − η⁢m̂/(√v̂ + ε)", "math source")?;
  u:assert_text_eq(u:rs_ir_m_text(ir), "Θ ← (W B)\nG ← ∇Θ L\n(M V) ← ↻ (M V) G\nM̂ ← M ÷ 1−β₁*T\nV̂ ← V ÷ 1−β₂*T\nΘ ← Θ − η×M̂ ÷ √V̂ + ε", "m text: the tuple, its gradient, the state step, the corrections, the step")?;
  u:assert_eq(u:rs_face_uses(ir.faces.math, "theta") + u:rs_face_uses(ir.faces.math, "step") + u:rs_face_uses(ir.faces.m, "partial"), 0, "Θ and ↻ are the notation's, ∂ is paper's")?;
  rows = u:ad_train(ad_t_eta, ad_t_beta1, ad_t_beta2, ad_t_eps, 30);
  trace = u:ad_trace(rows, 6);
  u:assert_text_eq(u:t_ad_unknown(ir, record_keys(trace.channels)), "", "channel keys are symbols")?;
  u:assert_text_eq(u:t_ad_unknown(ir, record_keys(trace.constants)), "", "constant keys are symbols")?;
  u:assert_eq(trace.channels.m.shape, [31, 2], "a moment pair per epoch")?;
  u:assert_eq(str_eq(read_text("fixtures/adam/trace.json")?, unwrap(u:rs_json(trace))), 1, "trace fresh")?;
  u:assert_eq(str_eq(read_text("fixtures/adam/faces/math.svg")?, unwrap(u:rs_face_svg(ir, "math"))), 1, "math.svg fresh")?;
  parsed = unwrap(u:ad_read_trace("fixtures/adam/trace.json"));
  plain = unwrap(u:ad_read_trace("fixtures/one-neuron/trace.json"));
  out = unwrap(u:rs_scene_export(unwrap(u:ad_visual(parsed, plain, 5)), 4));
  u:assert_text_eq(u:t_ad_unknown(ir, out.ids), "", "edge ids are symbols")?;
  u:assert_text_eq(u:t_ad_unknown(ir, out.labels.ids), "", "label ids are symbols")?;
  u:assert_eq(out.panels.count, 3, "three panels")?;
  full = unwrap(u:rs_scene_export(unwrap(u:ad_scene(parsed, plain)), 4));
  u:assert_eq(full.frames.count, 31, "one frame per epoch")?;
  u:assert_eq(str_eq(read_text("fixtures/adam/scene.json")?, unwrap(u:rs_json(full))), 1, "scene.json fresh")
}

u:run_registered_tests()
