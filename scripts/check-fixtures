#!/bin/sh
# Every committed fixture is what a fresh MLPL run emits: regenerate each
# into tmp/ and compare byte for byte. A stale fixture is a page that
# replays numbers the programs no longer produce.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"
mkdir -p tmp/fixtures

status=0
# check SCRIPT OUTPUT FIXTURE...: run SCRIPT with OUTPUT as its argument (a
# file, or a directory the script fills), then compare each FIXTURE with the
# file of the same name that the run produced.
check() {
    script=$1
    output=$2
    shift 2
    ./scripts/run-mlpl "$script" -- "$output" >/dev/null
    for fixture in "$@"; do
        if [ -d "$output" ]; then
            fresh="$output/$(basename "$fixture")"
        else
            fresh=$output
        fi
        if ! cmp -s "$fresh" "$fixture"; then
            echo "stale fixture: $fixture differs from a fresh run of $script (regenerate with: just mlpl $script)" >&2
            status=1
        fi
    done
}

check demos/stones.mlpl tmp/fixtures/stones.json fixtures/stones.json
for dir in fixtures/*/; do
    stone=$(basename "$dir")
    [ -f "$dir/trace.json" ] || continue
    mkdir -p "tmp/fixtures/$stone/faces"
    check "demos/$stone/train.mlpl" "tmp/fixtures/$stone/trace.json" "$dir/trace.json"
    check "demos/$stone/faces.mlpl" "tmp/fixtures/$stone/faces" "$dir/faces/math.svg" "$dir/faces/m.svg" "$dir/faces/equation.json"
    check "demos/$stone/scene.mlpl" "tmp/fixtures/$stone/scene.json" "$dir/scene.json"
    [ -f "demos/$stone/trace-scene.mlpl" ] && check "demos/$stone/trace-scene.mlpl" "tmp/fixtures/$stone/trace-scene.json" "$dir/trace-scene.json"
done

[ "$status" -eq 0 ] || exit 1
echo "PASS fixtures are fresh"
