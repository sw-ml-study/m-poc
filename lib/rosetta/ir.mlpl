# The equation IR: one record from which every face of the stone is rendered. Symbols carry meaning (id, role, name); each face is an ordered surface rendering of those symbols as tokens. Math text, M text, and the token table the page uses to link faces all come from here, so the faces cannot drift apart. Lists are kept as pipe-delimited text because MLPL string lists cannot be appended to; they are split once on export.

def u:rs_face_new() {
  "Start an empty face: no tokens and no lines.";
  {count: 0, line_count: 0, ids: "", texts: "", seps: fill([0], 0), lines: fill([0], 0), modes: fill([0], 0), line_docs: "", title: "", purpose: ""}
}

def u:rs_ir_new(name, description) {
  "Start an empty equation record with a name and a one-line description.";
  {schema: "sw-ml-study.rosetta.equation", version: 1, name: name, title: name, description: description, visual_title: "", visual_purpose: "", symbol_count: 0, symbol_ids: "", symbol_roles: "", symbol_names: "", symbol_docs: "", faces: {math: u:rs_face_new(), m: u:rs_face_new()}}
}

def u:rs_delimited_append(text, count, item) {
  "Append one item to a pipe-delimited list text that already holds count items.";
  if eq(count, 0) {
    item
  } else {
    str_concat(str_concat(text, "|"), item)
  }
}

def u:rs_delimited_index(text, count, item) {
  "Index of an exact item in a pipe-delimited list text, or negative one.";
  found = -1;
  if gt(count, 0) {
    items = str_split(text, "|");
    index = 0;
    while lt(index, count) {
      if str_eq(unwrap(list_get(items, index)), item) {
        found = index
      };
      index = index + 1
    }
  };
  found
}

def u:rs_role_valid(role) {
  "A symbol role is one of var, param, hyper, op, or punct.";
  str_eq(role, "var") + str_eq(role, "param") + str_eq(role, "hyper") + str_eq(role, "op") + str_eq(role, "punct")
}

def u:rs_id_valid(id) {
  "A symbol id is non-empty and free of the delimiter characters the IR uses.";
  gt(str_len(id), 0) * eq(str_find(id, "|"), -1) * eq(str_find(id, ":"), -1) * eq(str_find(id, "~"), -1)
}

def u:rs_ir_symbol_index(ir, id) {
  "Index of a symbol id in the record, or negative one.";
  u:rs_delimited_index(ir.symbol_ids, ir.symbol_count, id)
}

def u:rs_ir_symbol_doc(ir, id, role, name, doc) {
  "Add one symbol: an id shared by every face, a role, a human name, and a one-sentence doc for the page's callouts. Fails closed on a bad id, a bad role, a name or doc holding the delimiter, or a duplicate.";
  if 1 - u:rs_id_valid(id) {
    err({kind: "rosetta_symbol", message: str_concat("invalid symbol id: ", id)})
  } else {
    if 1 - u:rs_role_valid(role) {
      err({kind: "rosetta_symbol", message: str_concat("invalid symbol role: ", role)})
    } else {
      if 1 - (eq(str_find(name, "|"), -1) * eq(str_find(doc, "|"), -1)) {
        err({kind: "rosetta_symbol", message: str_concat("symbol name or doc holds a delimiter: ", name)})
      } else {
        if 1 - eq(u:rs_ir_symbol_index(ir, id), -1) {
          err({kind: "rosetta_symbol", message: str_concat("duplicate symbol id: ", id)})
        } else {
          n = ir.symbol_count;
          ok({schema: ir.schema, version: ir.version, name: ir.name, title: ir.title, description: ir.description, visual_title: ir.visual_title, visual_purpose: ir.visual_purpose, symbol_count: n + 1, symbol_ids: u:rs_delimited_append(ir.symbol_ids, n, id), symbol_roles: u:rs_delimited_append(ir.symbol_roles, n, role), symbol_names: u:rs_delimited_append(ir.symbol_names, n, name), symbol_docs: u:rs_delimited_append(ir.symbol_docs, n, doc), faces: ir.faces})
        }
      }
    }
  }
}

def u:rs_ir_symbol(ir, id, role, name) {
  "Add one symbol without a doc; the same as u:rs_ir_symbol_doc with an empty doc.";
  u:rs_ir_symbol_doc(ir, id, role, name, "")
}

def u:rs_ir_undocumented(ir) {
  "The first symbol id whose doc is empty, or the empty string when every symbol is documented.";
  ids = str_split(ir.symbol_ids, "|");
  docs = str_split(ir.symbol_docs, "|");
  index = 0;
  missing = "";
  while lt(index, ir.symbol_count) {
    if eq(str_len(unwrap(list_get(docs, index))), 0) {
      missing = unwrap(list_get(ids, index))
    };
    index = index + 1
  };
  missing
}

def u:rs_face_named(ir, face_name) {
  "Select a face of the record by name: math or m.";
  if str_eq(face_name, "math") {
    ok(ir.faces.math)
  } else {
    if str_eq(face_name, "m") {
      ok(ir.faces.m)
    } else {
      err({kind: "rosetta_face", message: str_concat("unknown face: ", face_name)})
    }
  }
}

def u:rs_ir_with_face(ir, face_name, face) {
  "Rebuild the record with one face replaced.";
  faces = if str_eq(face_name, "math") {
    {math: face, m: ir.faces.m}
  } else {
    {math: ir.faces.math, m: face}
  };
  {schema: ir.schema, version: ir.version, name: ir.name, title: ir.title, description: ir.description, visual_title: ir.visual_title, visual_purpose: ir.visual_purpose, symbol_count: ir.symbol_count, symbol_ids: ir.symbol_ids, symbol_roles: ir.symbol_roles, symbol_names: ir.symbol_names, symbol_docs: ir.symbol_docs, faces: faces}
}

def u:rs_face_token(face, id, text, sep, line, mode) {
  "Append one token to a face: the symbol it renders, its surface text, whether a space precedes it, its line, and its mode: 0 plain, 1 subscript, 2 superscript, 3 big operator, 4 lower limit, 5 upper limit.";
  n = face.count;
  {count: n + 1, line_count: line + 1, ids: u:rs_delimited_append(face.ids, n, id), texts: u:rs_delimited_append(face.texts, n, text), seps: concat(face.seps, sep), lines: concat(face.lines, line), modes: concat(face.modes, mode), line_docs: if gt(line, face.line_count - 1) {
      u:rs_delimited_append(face.line_docs, line, "")
    } else {
      face.line_docs
    }, title: face.title, purpose: face.purpose}
}

def u:rs_token_mode(marker) {
  "The mode a token spec's marker character asks for: underscore subscript, caret superscript, bang big operator, less-than lower limit, greater-than upper limit; anything else is plain (negative one).";
  if str_eq(marker, "_") {
    1
  } else {
    if str_eq(marker, "^") {
      2
    } else {
      if str_eq(marker, "!") {
        3
      } else {
        if str_eq(marker, "<") {
          4
        } else {
          if str_eq(marker, ">") {
            5
          } else {
            -1
          }
        }
      }
    }
  }
}

def u:rs_ir_line(ir, face_name, spec) {
  "Append one line to a face from a spec: tokens separated by pipes, each id:text, where a text starting with a tilde takes no space before it, and a text starting with a marker sets its mode: _ subscript, ^ superscript, ! big operator, < lower limit, > upper limit (after a big operator, lower-limit tokens come first, then upper-limit tokens; scripted tokens take no space). Every id must already be a symbol.";
  face = u:rs_face_named(ir, face_name)?;
  tokens = str_split(spec, "|");
  line = face.line_count;
  index = 0;
  failure = "";
  while lt(index, list_len(tokens)) {
    token = unwrap(list_get(tokens, index));
    colon = str_find(token, ":");
    if lt(colon, 1) {
      failure = str_concat("token without an id: ", token)
    } else {
      id = str_slice(token, 0, colon);
      raw = str_slice(token, colon + 1, str_len(token));
      tilde = str_eq(str_slice(raw, 0, 1), "~");
      raw = if tilde {
        str_slice(raw, 1, str_len(raw))
      } else {
        raw
      };
      mode = u:rs_token_mode(str_slice(raw, 0, 1));
      text = if lt(mode, 0) {
        raw
      } else {
        str_slice(raw, 1, str_len(raw))
      };
      mode = if lt(mode, 0) {
        0
      } else {
        mode
      };
      if eq(u:rs_ir_symbol_index(ir, id), -1) {
        failure = str_concat("token names an unknown symbol: ", id)
      } else {
        if eq(str_len(text), 0) {
          failure = str_concat("token without text: ", token)
        } else {
          face = u:rs_face_token(face, id, text, (1 - tilde) * eq(mode, 0) + eq(mode, 3) * (1 - tilde), line, mode)
        }
      }
    };
    index = index + 1
  };
  if gt(str_len(failure), 0) {
    err({kind: "rosetta_line", message: failure})
  } else {
    ok(u:rs_ir_with_face(ir, face_name, face))
  }
}

def u:rs_ir_line_doc(ir, face_name, line, doc) {
  "Give one line of a face a one-sentence doc for the page: what that line says. Fails closed on an unknown face, a line index past the face's lines, an empty doc, or a doc holding the delimiter.";
  face = u:rs_face_named(ir, face_name)?;
  if 1 - (gt(str_len(doc), 0) * eq(str_find(doc, "|"), -1)) {
    err({kind: "rosetta_line", message: "a line doc must be non-empty and free of the delimiter"})
  } else {
    if (lt(line, 0) + (1 - lt(line, face.line_count))) {
      err({kind: "rosetta_line", message: str_concat("no such line to document: ", to_string(line))})
    } else {
      docs = str_split(face.line_docs, "|");
      out = "";
      index = 0;
      while lt(index, face.line_count) {
        item = if eq(index, line) {
          doc
        } else {
          unwrap(list_get(docs, index))
        };
        out = u:rs_delimited_append(out, index, item);
        index = index + 1
      };
      ok(u:rs_ir_with_face(ir, face_name, {count: face.count, line_count: face.line_count, ids: face.ids, texts: face.texts, seps: face.seps, lines: face.lines, modes: face.modes, line_docs: out, title: face.title, purpose: face.purpose}))
    }
  }
}

def u:rs_ir_titled(ir, title) {
  "Give the record a short title for the page's selector and face headers (the name is its id).";
  if eq(str_len(title), 0) + gt(str_find(title, "|"), -1) {
    err({kind: "rosetta_title", message: "a title must be non-empty and free of the delimiter"})
  } else {
    ok({schema: ir.schema, version: ir.version, name: ir.name, title: title, description: ir.description, visual_title: ir.visual_title, visual_purpose: ir.visual_purpose, symbol_count: ir.symbol_count, symbol_ids: ir.symbol_ids, symbol_roles: ir.symbol_roles, symbol_names: ir.symbol_names, symbol_docs: ir.symbol_docs, faces: ir.faces})
  }
}

def u:rs_ir_face_doc(ir, face_name, title, purpose) {
  "Name a face and say what it is for: math, m, or visual (the Visual face is not a text face of the record, but its words live here so every face of a stone is documented in one place).";
  if eq(str_len(title), 0) + eq(str_len(purpose), 0) + gt(str_find(title, "|"), -1) + gt(str_find(purpose, "|"), -1) {
    err({kind: "rosetta_face", message: str_concat("a face doc needs a title and a purpose without the delimiter: ", face_name)})
  } else {
    if str_eq(face_name, "visual") {
      ok({schema: ir.schema, version: ir.version, name: ir.name, title: ir.title, description: ir.description, visual_title: title, visual_purpose: purpose, symbol_count: ir.symbol_count, symbol_ids: ir.symbol_ids, symbol_roles: ir.symbol_roles, symbol_names: ir.symbol_names, symbol_docs: ir.symbol_docs, faces: ir.faces})
    } else {
      face = u:rs_face_named(ir, face_name)?;
      ok(u:rs_ir_with_face(ir, face_name, {count: face.count, line_count: face.line_count, ids: face.ids, texts: face.texts, seps: face.seps, lines: face.lines, modes: face.modes, line_docs: face.line_docs, title: title, purpose: purpose}))
    }
  }
}

def u:rs_ir_undocumented_face(ir) {
  "The first face without a title and purpose, or the empty string.";
  if eq(str_len(ir.faces.math.title), 0) + eq(str_len(ir.faces.math.purpose), 0) {
    "math"
  } else {
    if eq(str_len(ir.faces.m.title), 0) + eq(str_len(ir.faces.m.purpose), 0) {
      "m"
    } else {
      if eq(str_len(ir.visual_title), 0) + eq(str_len(ir.visual_purpose), 0) {
        "visual"
      } else {
        ""
      }
    }
  }
}

def u:rs_face_line_doc(face, line) {
  "The doc of one line of a face, or the empty string.";
  if lt(line, face.line_count) {
    unwrap(list_get(str_split(face.line_docs, "|"), line))
  } else {
    ""
  }
}

def u:rs_ir_undocumented_line(ir) {
  "The first line without a doc, as face:index, or the empty string when every line of both faces is documented.";
  missing = "";
  index = 0;
  while lt(index, ir.faces.math.line_count) {
    if eq(str_len(u:rs_face_line_doc(ir.faces.math, index)), 0) {
      missing = str_concat("math:", to_string(index))
    };
    index = index + 1
  };
  index = 0;
  while lt(index, ir.faces.m.line_count) {
    if eq(str_len(u:rs_face_line_doc(ir.faces.m, index)), 0) {
      missing = str_concat("m:", to_string(index))
    };
    index = index + 1
  };
  missing
}

def u:rs_mode_open(mode) {
  "The renderer's opening marker for a run of tokens in a mode: _{ for subscripts and lower limits, ^{ for superscripts and upper limits, nothing otherwise.";
  if eq(mode, 1) + eq(mode, 4) {
    "_{"
  } else {
    if eq(mode, 2) + eq(mode, 5) {
      "^{"
    } else {
      ""
    }
  }
}

def u:rs_face_text(face) {
  "Render a face as the text the equation renderer reads: tokens joined by the spaces they asked for, lines separated by newlines, and runs of scripted tokens wrapped in the renderer's _{ } and ^{ } markers.";
  out = "";
  if gt(face.count, 0) {
    texts = str_split(face.texts, "|");
    index = 0;
    open = 0;
    while lt(index, face.count) {
      line = take(face.lines, 0, index);
      mode = take(face.modes, 0, index);
      new_line = if gt(index, 0) {
        1 - eq(line, take(face.lines, 0, index - 1))
      } else {
        0
      };
      run_ends = if gt(index, 0) {
        new_line + (1 - eq(mode, take(face.modes, 0, index - 1)))
      } else {
        1
      };
      if gt(run_ends, 0) * open {
        out = str_concat(out, "}");
        open = 0
      };
      if new_line {
        out = str_concat(out, "\n")
      } else {
        if gt(index, 0) * take(face.seps, 0, index) {
          out = str_concat(out, " ")
        }
      };
      if gt(run_ends, 0) * gt(str_len(u:rs_mode_open(mode)), 0) {
        out = str_concat(out, u:rs_mode_open(mode));
        open = 1
      };
      out = str_concat(out, unwrap(list_get(texts, index)));
      index = index + 1
    };
    if open {
      out = str_concat(out, "}")
    }
  };
  out
}

def u:rs_ir_math_text(ir) {
  "The Math face as text.";
  u:rs_face_text(ir.faces.math)
}

def u:rs_ir_m_text(ir) {
  "The proposed-M face as text.";
  u:rs_face_text(ir.faces.m)
}

def u:rs_face_uses(face, id) {
  "Whether a face renders the given symbol at least once.";
  1 - eq(u:rs_delimited_index(face.ids, face.count, id), -1)
}

def u:rs_ir_validate(ir) {
  "A record is complete when it has symbols, both faces have the same non-zero line count, and every symbol appears on at least one face (a notation may leave a symbol implicit: an APL reduce has no index).";
  if eq(ir.symbol_count, 0) {
    err({kind: "rosetta_validate", message: "no symbols"})
  } else {
    if eq(ir.faces.math.count, 0) + eq(ir.faces.m.count, 0) {
      err({kind: "rosetta_validate", message: "a face has no tokens"})
    } else {
      if 1 - eq(ir.faces.math.line_count, ir.faces.m.line_count) {
        err({kind: "rosetta_validate", message: "faces have different line counts"})
      } else {
        ids = str_split(ir.symbol_ids, "|");
        index = 0;
        missing = "";
        while lt(index, ir.symbol_count) {
          id = unwrap(list_get(ids, index));
          if eq(u:rs_face_uses(ir.faces.math, id) + u:rs_face_uses(ir.faces.m, id), 0) {
            missing = id
          };
          index = index + 1
        };
        if gt(str_len(missing), 0) {
          err({kind: "rosetta_validate", message: str_concat("symbol on no face: ", missing)})
        } else {
          ok(1)
        }
      }
    }
  }
}

def u:rs_face_export(face) {
  "A face as lists and arrays, for JSON: the token table the page links faces with.";
  {count: face.count, line_count: face.line_count, ids: str_split(face.ids, "|"), texts: str_split(face.texts, "|"), seps: face.seps, lines: face.lines, modes: face.modes, line_docs: str_split(face.line_docs, "|"), text: u:rs_face_text(face), title: face.title, purpose: face.purpose}
}

def u:rs_ir_export(ir) {
  "The validated record as lists and arrays, for JSON.";
  u:rs_ir_validate(ir)?;
  ok({schema: ir.schema, version: ir.version, name: ir.name, title: ir.title, description: ir.description, visual: {title: ir.visual_title, purpose: ir.visual_purpose}, symbols: {count: ir.symbol_count, ids: str_split(ir.symbol_ids, "|"), roles: str_split(ir.symbol_roles, "|"), names: str_split(ir.symbol_names, "|"), docs: str_split(ir.symbol_docs, "|")}, faces: {math: u:rs_face_export(ir.faces.math), m: u:rs_face_export(ir.faces.m)}})
}

def u:rs_ir_json(ir) {
  "The validated record as deterministic JSON text.";
  exported = u:rs_ir_export(ir)?;
  to_json(exported, {tagged: 0})
}
