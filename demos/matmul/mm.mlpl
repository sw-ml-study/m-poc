# The third stone's computation: a 2×3 by 3×2 matrix product, accumulated one k at a time so the page can replay C growing. u:mm_steps records, for t = 0..K, the partial product summed over k ≤ t and the products added at step t; u:mm_trace turns the rows into the trace record the page replays, keyed by the equation's symbol ids. The final matrix is checked against MLPL's matmul by the tests.
include "../../lib/rosetta/emit.mlpl";
include "equation.mlpl";

mm_a = reshape([1, 2, 0.5, -1, 0, 2], [2, 3]);
mm_b = reshape([2, 1, 0.5, -1, 1, 3], [3, 2]);

def u:mm_outer(k) {
  "The products contributed by index k: column k of A times row k of B, as a [rows, cols] matrix.";
  col = take(transpose(mm_a), 0, k);
  row = take(mm_b, 0, k);
  reshape(col, [len(col), 1]) * reshape(row, [1, len(row)])
}

def u:mm_steps() {
  "One row per step t = 0..K: the partial product over k < t (all zeros at t = 0, the full product at t = K), the products added at step t (zeros at t = 0), and the index just added.";
  rows = take(shape(mm_a), 0, 0);
  cols = take(shape(mm_b), 0, 1);
  kk = take(shape(mm_a), 0, 1);
  partial = fill([rows, cols], 0);
  partials = flatten(partial);
  terms = flatten(fill([rows, cols], 0));
  index = [0];
  t = 1;
  while lt(t, kk + 1) {
    term = u:mm_outer(t - 1);
    partial = partial + term;
    partials = concat(partials, flatten(partial));
    terms = concat(terms, flatten(term));
    index = concat(index, t);
    t = t + 1
  };
  {rows: rows, cols: cols, kk: kk, a: mm_a, b: mm_b, C: reshape(partials, [kk + 1, rows, cols]), term: reshape(terms, [kk + 1, rows, cols]), k: index}
}

def u:mm_trace(rows, places) {
  "The trace record: the axis is k (rows.kk + 1 steps), the constants are A and B, the channels are the partial product C, the products added (mul) and the index k.";
  {schema: "sw-ml-study.rosetta.trace", version: 1, equation: "matmul", axis: {name: "k", count: rows.kk + 1}, constants: {A: u:rs_array_json(rows.a), B: u:rs_array_json(rows.b)}, channels: {C: u:rs_array_json(u:rs_round(rows.C, places)), mul: u:rs_array_json(u:rs_round(rows.term, places)), k: rows.k}}
}
