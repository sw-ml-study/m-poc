# Normalize the image pixel by pixel and write the trace the page replays: fixtures/image-normalization/trace.json by default, or the path given as the script's argument. The JSON written is also printed; the reg-rs baseline rosetta_image_normalization_trace pins it.
include "compute.mlpl";

in_path = if gt(list_len(args()), 0) {
  unwrap(list_get(args(), 0))
} else {
  "fixtures/image-normalization/trace.json"
};

text = unwrap(u:rs_write_json(in_path, u:in_trace(u:in_steps(), 6)));
print(text);
str_concat("wrote ", in_path)
