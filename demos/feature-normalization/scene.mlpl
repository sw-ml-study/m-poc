# Build the Visual face of feature normalization from the committed trace and write it: fixtures/feature-normalization/scene.json by default, or the path given as the script's argument. The JSON written is also printed; the reg-rs baseline rosetta_feature_normalization_scene pins it.
include "visual.mlpl";

fn_path = if gt(list_len(args()), 0) {
  unwrap(list_get(args(), 0))
} else {
  "fixtures/feature-normalization/scene.json"
};

trace = unwrap(u:fn_read_trace("fixtures/feature-normalization/trace.json"));
scene = unwrap(u:fn_scene(trace));
text = unwrap(u:rs_write_json(fn_path, unwrap(u:rs_scene_export(scene, 4))));
print(text);
str_concat("wrote ", fn_path)
