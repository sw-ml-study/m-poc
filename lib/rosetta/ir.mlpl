# The equation IR: one record from which every face of the stone is rendered. Symbols carry meaning (id, role, name); each face is an ordered surface rendering of those symbols as tokens. Math text, M text, and the token table the page uses to link faces all come from here, so the faces cannot drift apart. Lists are kept as pipe-delimited text because MLPL string lists cannot be appended to; they are split once on export.

def u:rs_face_new() {
  "Start an empty face: no tokens and no lines.";
  {count: 0, line_count: 0, ids: "", texts: "", seps: fill([0], 0), lines: fill([0], 0)}
}

def u:rs_ir_new(name, description) {
  "Start an empty equation record with a name and a one-line description.";
  {schema: "sw-ml-study.rosetta.equation", version: 1, name: name, description: description, symbol_count: 0, symbol_ids: "", symbol_roles: "", symbol_names: "", faces: {math: u:rs_face_new(), m: u:rs_face_new()}}
}

def u:rs_delimited_append(text, count, item) {
  "Append one item to a pipe-delimited list text that already holds count items.";
  if eq(count, 0) {
    item
  } else {
    str_concat(str_concat(text, "|"), item)
  }
}

def u:rs_delimited_index(text, count, item) {
  "Index of an exact item in a pipe-delimited list text, or negative one.";
  found = -1;
  if gt(count, 0) {
    items = str_split(text, "|");
    index = 0;
    while lt(index, count) {
      if str_eq(unwrap(list_get(items, index)), item) {
        found = index
      };
      index = index + 1
    }
  };
  found
}

def u:rs_role_valid(role) {
  "A symbol role is one of var, param, hyper, op, or punct.";
  str_eq(role, "var") + str_eq(role, "param") + str_eq(role, "hyper") + str_eq(role, "op") + str_eq(role, "punct")
}

def u:rs_id_valid(id) {
  "A symbol id is non-empty and free of the delimiter characters the IR uses.";
  gt(str_len(id), 0) * eq(str_find(id, "|"), -1) * eq(str_find(id, ":"), -1) * eq(str_find(id, "~"), -1)
}

def u:rs_ir_symbol_index(ir, id) {
  "Index of a symbol id in the record, or negative one.";
  u:rs_delimited_index(ir.symbol_ids, ir.symbol_count, id)
}

def u:rs_ir_symbol(ir, id, role, name) {
  "Add one symbol: an id shared by every face, a role, and a human name. Fails closed on a bad id, a bad role, a name holding the delimiter, or a duplicate.";
  if 1 - u:rs_id_valid(id) {
    err({kind: "rosetta_symbol", message: str_concat("invalid symbol id: ", id)})
  } else {
    if 1 - u:rs_role_valid(role) {
      err({kind: "rosetta_symbol", message: str_concat("invalid symbol role: ", role)})
    } else {
      if 1 - eq(str_find(name, "|"), -1) {
        err({kind: "rosetta_symbol", message: str_concat("symbol name holds a delimiter: ", name)})
      } else {
        if 1 - eq(u:rs_ir_symbol_index(ir, id), -1) {
          err({kind: "rosetta_symbol", message: str_concat("duplicate symbol id: ", id)})
        } else {
          n = ir.symbol_count;
          ok({schema: ir.schema, version: ir.version, name: ir.name, description: ir.description, symbol_count: n + 1, symbol_ids: u:rs_delimited_append(ir.symbol_ids, n, id), symbol_roles: u:rs_delimited_append(ir.symbol_roles, n, role), symbol_names: u:rs_delimited_append(ir.symbol_names, n, name), faces: ir.faces})
        }
      }
    }
  }
}

def u:rs_face_named(ir, face_name) {
  "Select a face of the record by name: math or m.";
  if str_eq(face_name, "math") {
    ok(ir.faces.math)
  } else {
    if str_eq(face_name, "m") {
      ok(ir.faces.m)
    } else {
      err({kind: "rosetta_face", message: str_concat("unknown face: ", face_name)})
    }
  }
}

def u:rs_ir_with_face(ir, face_name, face) {
  "Rebuild the record with one face replaced.";
  faces = if str_eq(face_name, "math") {
    {math: face, m: ir.faces.m}
  } else {
    {math: ir.faces.math, m: face}
  };
  {schema: ir.schema, version: ir.version, name: ir.name, description: ir.description, symbol_count: ir.symbol_count, symbol_ids: ir.symbol_ids, symbol_roles: ir.symbol_roles, symbol_names: ir.symbol_names, faces: faces}
}

def u:rs_face_token(face, id, text, sep, line) {
  "Append one token to a face: the symbol it renders, its surface text, whether a space precedes it, and its line.";
  n = face.count;
  {count: n + 1, line_count: line + 1, ids: u:rs_delimited_append(face.ids, n, id), texts: u:rs_delimited_append(face.texts, n, text), seps: concat(face.seps, sep), lines: concat(face.lines, line)}
}

def u:rs_ir_line(ir, face_name, spec) {
  "Append one line to a face from a spec: tokens separated by pipes, each id:text, where a text starting with a tilde takes no space before it. Every id must already be a symbol.";
  face = u:rs_face_named(ir, face_name)?;
  tokens = str_split(spec, "|");
  line = face.line_count;
  index = 0;
  failure = "";
  while lt(index, list_len(tokens)) {
    token = unwrap(list_get(tokens, index));
    colon = str_find(token, ":");
    if lt(colon, 1) {
      failure = str_concat("token without an id: ", token)
    } else {
      id = str_slice(token, 0, colon);
      raw = str_slice(token, colon + 1, str_len(token));
      tilde = str_eq(str_slice(raw, 0, 1), "~");
      text = if tilde {
        str_slice(raw, 1, str_len(raw))
      } else {
        raw
      };
      if eq(u:rs_ir_symbol_index(ir, id), -1) {
        failure = str_concat("token names an unknown symbol: ", id)
      } else {
        if eq(str_len(text), 0) {
          failure = str_concat("token without text: ", token)
        } else {
          face = u:rs_face_token(face, id, text, 1 - tilde, line)
        }
      }
    };
    index = index + 1
  };
  if gt(str_len(failure), 0) {
    err({kind: "rosetta_line", message: failure})
  } else {
    ok(u:rs_ir_with_face(ir, face_name, face))
  }
}

def u:rs_face_text(face) {
  "Render a face as text: tokens joined by the spaces they asked for, lines separated by newlines.";
  out = "";
  if gt(face.count, 0) {
    texts = str_split(face.texts, "|");
    index = 0;
    while lt(index, face.count) {
      line = take(face.lines, 0, index);
      if gt(index, 0) {
        if 1 - eq(line, take(face.lines, 0, index - 1)) {
          out = str_concat(out, "\n")
        } else {
          if take(face.seps, 0, index) {
            out = str_concat(out, " ")
          }
        }
      };
      out = str_concat(out, unwrap(list_get(texts, index)));
      index = index + 1
    }
  };
  out
}

def u:rs_ir_math_text(ir) {
  "The Math face as text.";
  u:rs_face_text(ir.faces.math)
}

def u:rs_ir_m_text(ir) {
  "The proposed-M face as text.";
  u:rs_face_text(ir.faces.m)
}

def u:rs_face_uses(face, id) {
  "Whether a face renders the given symbol at least once.";
  1 - eq(u:rs_delimited_index(face.ids, face.count, id), -1)
}

def u:rs_ir_validate(ir) {
  "A record is complete when it has symbols, both faces have the same non-zero line count, and every symbol appears on every face.";
  if eq(ir.symbol_count, 0) {
    err({kind: "rosetta_validate", message: "no symbols"})
  } else {
    if eq(ir.faces.math.count, 0) + eq(ir.faces.m.count, 0) {
      err({kind: "rosetta_validate", message: "a face has no tokens"})
    } else {
      if 1 - eq(ir.faces.math.line_count, ir.faces.m.line_count) {
        err({kind: "rosetta_validate", message: "faces have different line counts"})
      } else {
        ids = str_split(ir.symbol_ids, "|");
        index = 0;
        missing = "";
        while lt(index, ir.symbol_count) {
          id = unwrap(list_get(ids, index));
          if 1 - (u:rs_face_uses(ir.faces.math, id) * u:rs_face_uses(ir.faces.m, id)) {
            missing = id
          };
          index = index + 1
        };
        if gt(str_len(missing), 0) {
          err({kind: "rosetta_validate", message: str_concat("symbol missing from a face: ", missing)})
        } else {
          ok(1)
        }
      }
    }
  }
}

def u:rs_face_export(face) {
  "A face as lists and arrays, for JSON: the token table the page links faces with.";
  {count: face.count, line_count: face.line_count, ids: str_split(face.ids, "|"), texts: str_split(face.texts, "|"), seps: face.seps, lines: face.lines, text: u:rs_face_text(face)}
}

def u:rs_ir_export(ir) {
  "The validated record as lists and arrays, for JSON.";
  u:rs_ir_validate(ir)?;
  ok({schema: ir.schema, version: ir.version, name: ir.name, description: ir.description, symbols: {count: ir.symbol_count, ids: str_split(ir.symbol_ids, "|"), roles: str_split(ir.symbol_roles, "|"), names: str_split(ir.symbol_names, "|")}, faces: {math: u:rs_face_export(ir.faces.math), m: u:rs_face_export(ir.faces.m)}})
}

def u:rs_ir_json(ir) {
  "The validated record as deterministic JSON text.";
  exported = u:rs_ir_export(ir)?;
  to_json(exported, {tagged: 0})
}
