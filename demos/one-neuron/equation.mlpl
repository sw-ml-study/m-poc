# The first stone's equation: one neuron, a linear fit trained by gradient descent, as one IR record. The Math face is paper notation; the M face is proposed notation whose glyphs are placeholders (see docs/plan.md). Both are rendered from the symbols declared here. Paper notation multiplies by juxtaposition, so on the Math face the multiply symbol is carried by U+2062 INVISIBLE TIMES (the character MathML uses for it): it renders as nothing and still gives focus something to find.
include "../../lib/rosetta/ir.mlpl";

def u:on_equation() {
  "Build the one-neuron equation record: prediction, squared loss, and the gradient-descent updates of the weight and the bias, every symbol with a one-sentence doc for the page.";
  ir = u:rs_ir_new("one-neuron", "One neuron: a linear fit ŷ = wx + b trained by gradient descent on the squared error.");
  ir = u:rs_ir_symbol_doc(ir, "yhat", "var", "prediction", "The prediction: what the neuron thinks y is for this x. The hat means an estimate of y.")?;
  ir = u:rs_ir_symbol_doc(ir, "w", "param", "weight", "The weight, the slope of the fitted line; trained, so it changes every epoch.")?;
  ir = u:rs_ir_symbol_doc(ir, "x", "var", "input", "The input: one of the four given x values.")?;
  ir = u:rs_ir_symbol_doc(ir, "b", "param", "bias", "The bias, the intercept of the fitted line at x = 0; trained, so it changes every epoch.")?;
  ir = u:rs_ir_symbol_doc(ir, "L", "var", "loss", "The loss: how wrong the prediction is, the squared error, averaged over the four points for training.")?;
  ir = u:rs_ir_symbol_doc(ir, "y", "var", "target", "The target: the y value the data says goes with this x.")?;
  ir = u:rs_ir_symbol_doc(ir, "eta", "hyper", "learning rate", "The learning rate η (eta): how big a step gradient descent takes each epoch; here 0.1.")?;
  ir = u:rs_ir_symbol_doc(ir, "grad_w", "op", "gradient of the loss with respect to the weight", "How much the loss changes for a small change in w; the update steps w against it.")?;
  ir = u:rs_ir_symbol_doc(ir, "grad_b", "op", "gradient of the loss with respect to the bias", "How much the loss changes for a small change in b; the update steps b against it.")?;
  ir = u:rs_ir_symbol_doc(ir, "eq", "op", "definition", "Definition: the left side is computed from the right side.")?;
  ir = u:rs_ir_symbol_doc(ir, "assign", "op", "update", "Update: the parameter takes a new value for the next epoch; assignment across time.")?;
  ir = u:rs_ir_symbol_doc(ir, "add", "op", "add", "Addition.")?;
  ir = u:rs_ir_symbol_doc(ir, "sub", "op", "subtract", "Subtraction; in the loss, the residual y − ŷ.")?;
  ir = u:rs_ir_symbol_doc(ir, "mul", "op", "multiply", "Multiplication; written by juxtaposition on the Math face, as wx.")?;
  ir = u:rs_ir_symbol_doc(ir, "sq", "op", "square", "Square: the residual squared, so under- and over-shooting count the same and big misses count more.")?;
  ir = u:rs_ir_symbol_doc(ir, "lp", "punct", "open", "Open parenthesis: group the residual before squaring.")?;
  ir = u:rs_ir_symbol_doc(ir, "rp", "punct", "close", "Close parenthesis.")?;
  ir = u:rs_ir_line(ir, "math", "yhat:ŷ|eq:=|w:w|mul:~⁢|x:~x|add:+|b:b")?;
  ir = u:rs_ir_line(ir, "math", "L:L|eq:=|lp:(|y:~y|sub:−|yhat:ŷ|rp:~)|sq:~²")?;
  ir = u:rs_ir_line(ir, "math", "w:w|assign:←|w:w|sub:−|eta:η|mul:~⁢|grad_w:∂L/∂w")?;
  ir = u:rs_ir_line(ir, "math", "b:b|assign:←|b:b|sub:−|eta:η|mul:~⁢|grad_b:∂L/∂b")?;
  ir = u:rs_ir_line(ir, "m", "yhat:Ŷ|eq:←|b:B|add:+|w:W|mul:~×|x:~X")?;
  ir = u:rs_ir_line(ir, "m", "L:L|eq:←|lp:(|y:~Y|sub:~−|yhat:~Ŷ|rp:~)|sq:~*2")?;
  ir = u:rs_ir_line(ir, "m", "w:W|assign:←|w:W|sub:−|eta:η|mul:~×|grad_w:~∇W L")?;
  ir = u:rs_ir_line(ir, "m", "b:B|assign:←|b:B|sub:−|eta:η|mul:~×|grad_b:~∇B L")?;
  u:rs_ir_validate(ir)?;
  ok(ir)
}
