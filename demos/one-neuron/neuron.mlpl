# The first stone's computation: one neuron, ŷ = wx + b, fitted to four points by full-batch gradient descent on the mean squared error. The parameters are sw-MLPL param leaves and every gradient comes from grad; nothing here is typed in. u:on_train records one row per epoch (the state before that epoch's update, its loss and its gradients) and u:on_trace turns the rows into the trace record the page replays, keyed by the equation's symbol ids so focus can find a value for a token.
include "../../lib/rosetta/emit.mlpl";
include "equation.mlpl";

on_x = [0.0, 1.0, 2.0, 3.0];
on_y = [1.2, 2.9, 5.1, 6.8];
on_w = param[1];
on_w = [0.0];
on_b = param[1];
on_b = [0.0];

def u:on_predict() {
  "The prediction for every input at the current parameters: ŷ = wx + b.";
  on_w * on_x + on_b
}

def u:on_loss() {
  "The loss trained: the mean over the four points of (y − ŷ)².";
  d = on_y - u:on_predict();
  reduce_add(d * d) / len(on_x)
}

def u:on_reset() {
  "Put both parameters back at zero, so training is repeatable within one process.";
  global_set("on_w", [0.0]);
  global_set("on_b", [0.0]);
  1
}

def u:on_train(eta, epochs) {
  "Train from zero for a number of epochs at learning rate eta and return the unrounded rows: for epoch t, the parameters before the update, the prediction and loss at them, and the gradients grad computed there. Row epochs is the final state, whose gradients are recorded but not applied.";
  u:on_reset();
  w = fill([0], 0);
  b = fill([0], 0);
  loss = fill([0], 0);
  grad_w = fill([0], 0);
  grad_b = fill([0], 0);
  yhat = fill([0], 0);
  t = 0;
  while lt(t, epochs + 1) {
    gw = grad(u:on_loss(), on_w);
    gb = grad(u:on_loss(), on_b);
    w = concat(w, on_w);
    b = concat(b, on_b);
    loss = concat(loss, u:on_loss());
    grad_w = concat(grad_w, gw);
    grad_b = concat(grad_b, gb);
    yhat = concat(yhat, u:on_predict());
    if lt(t, epochs) {
      global_set("on_w", on_w - eta * gw);
      global_set("on_b", on_b - eta * gb)
    };
    t = t + 1
  };
  {eta: eta, epochs: epochs, x: on_x, y: on_y, w: w, b: b, L: loss, grad_w: grad_w, grad_b: grad_b, yhat: reshape(yhat, [epochs + 1, len(on_x)])}
}

def u:on_trace(rows, places) {
  "The trace record the page replays, rounded to places decimals: an axis (epochs), the constants and the per-epoch channels, every key an id from the one-neuron equation record; the per-point prediction is a shape-and-values record like the line-scene arrays.";
  {schema: "sw-ml-study.rosetta.trace", version: 1, equation: "one-neuron", axis: {name: "epoch", count: rows.epochs + 1}, constants: {eta: rows.eta, x: rows.x, y: rows.y}, channels: {w: u:rs_round(rows.w, places), b: u:rs_round(rows.b, places), L: u:rs_round(rows.L, places), grad_w: u:rs_round(rows.grad_w, places), grad_b: u:rs_round(rows.grad_b, places), yhat: u:rs_array_json(u:rs_round(rows.yhat, places))}}
}
