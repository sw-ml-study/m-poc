# The visual face of the stone as a line scene: MLPL owns the geometry, a projector owns the pixels. A scene is vertices in three dimensions, edges between them, an RGBA color and a symbol id per edge, text labels anchored at points, and optionally frames: a complete vertex array per step of a time axis, so the projector replays motion without knowing what moves. The export is the sw-ml-study.native3d.line-scene record (positions, edges, controls) extended with ids, colors, labels and frames; arrays of rank two or more are shape-plus-values like the rest of the fixtures. Lists of ids and texts are pipe-delimited text while a scene is built, as in the equation IR.
include "ir.mlpl";
include "emit.mlpl";

def u:rs_scene_new(axis_name) {
  "Start an empty scene whose frames, if any, step along the named axis.";
  {schema: "sw-ml-study.native3d.line-scene", version: 1, axis: axis_name, vertex_count: 0, positions: fill([0], 0), edge_count: 0, edges: fill([0], 0), edge_ids: "", edge_colors: fill([0], 0), label_count: 0, label_ids: "", label_texts: "", label_positions: fill([0], 0), frame_count: 0, frames: fill([0], 0)}
}

def u:rs_finite(values) {
  "Whether every value of an array is a finite number.";
  if eq(len(values), 0) {
    1
  } else {
    reduce(:min, (values == values) * lt(abs(values), pow(10, 300)))
  }
}

def u:rs_dim(values, axis) {
  "The extent of an array along an axis, or negative one when the array has no such axis; safe to ask of any value.";
  if gt(rank(values), axis) {
    take(shape(values), 0, axis)
  } else {
    -1
  }
}

def u:rs_color_valid(color) {
  "A color is four finite numbers in the unit interval: red, green, blue, alpha.";
  eq(rank(color), 1) * eq(len(color), 4) * u:rs_finite(color) * (1 - gt(reduce(:max, color), 1)) * (1 - lt(reduce(:min, color), 0))
}

def u:rs_scene_with(scene, vertex_count, positions, edge_count, edges, edge_ids, edge_colors, label_count, label_ids, label_texts, label_positions, frame_count, frames) {
  "Rebuild a scene record with every table replaced.";
  {schema: scene.schema, version: scene.version, axis: scene.axis, vertex_count: vertex_count, positions: positions, edge_count: edge_count, edges: edges, edge_ids: edge_ids, edge_colors: edge_colors, label_count: label_count, label_ids: label_ids, label_texts: label_texts, label_positions: label_positions, frame_count: frame_count, frames: frames}
}

def u:rs_scene_vertices(scene, points) {
  "Append vertices from a [k, 3] array of finite positions; their indices start at the scene's vertex count before the call. Frames must be added after every vertex.";
  if 1 - (eq(rank(points), 2) * eq(u:rs_dim(points, 1), 3)) {
    err({kind: "rosetta_scene", message: "vertices must be a [k, 3] array"})
  } else {
    if 1 - u:rs_finite(points) {
      err({kind: "rosetta_scene", message: "a vertex position is not finite"})
    } else {
      if gt(scene.frame_count, 0) {
        err({kind: "rosetta_scene", message: "vertices cannot be added once frames exist"})
      } else {
        ok(u:rs_scene_with(scene, scene.vertex_count + take(shape(points), 0, 0), concat(scene.positions, flatten(points)), scene.edge_count, scene.edges, scene.edge_ids, scene.edge_colors, scene.label_count, scene.label_ids, scene.label_texts, scene.label_positions, scene.frame_count, scene.frames))
      }
    }
  }
}

def u:rs_scene_edges(scene, pairs, id, color) {
  "Append edges from a [k, 2] array of vertex indices, all carrying one symbol id and one RGBA color. Fails closed on an index out of range, a non-integer index, a bad id, or a bad color.";
  if 1 - (eq(rank(pairs), 2) * eq(u:rs_dim(pairs, 1), 2)) {
    err({kind: "rosetta_scene", message: "edges must be a [k, 2] array"})
  } else {
    flat = flatten(pairs);
    in_range = u:rs_finite(flat) * (1 - lt(reduce(:min, flat), 0)) * lt(reduce(:max, flat), scene.vertex_count) * eq(reduce(:max, abs(flat - floor(flat))), 0);
    if 1 - in_range {
      err({kind: "rosetta_scene", message: str_concat("an edge names a vertex outside the scene: ", id)})
    } else {
      if 1 - u:rs_id_valid(id) {
        err({kind: "rosetta_scene", message: str_concat("invalid edge id: ", id)})
      } else {
        if 1 - u:rs_color_valid(color) {
          err({kind: "rosetta_scene", message: str_concat("invalid edge color for id: ", id)})
        } else {
          k = take(shape(pairs), 0, 0);
          ids = scene.edge_ids;
          colors = scene.edge_colors;
          index = 0;
          while lt(index, k) {
            ids = u:rs_delimited_append(ids, scene.edge_count + index, id);
            colors = concat(colors, color);
            index = index + 1
          };
          ok(u:rs_scene_with(scene, scene.vertex_count, scene.positions, scene.edge_count + k, concat(scene.edges, flat), ids, colors, scene.label_count, scene.label_ids, scene.label_texts, scene.label_positions, scene.frame_count, scene.frames))
        }
      }
    }
  }
}

def u:rs_scene_polyline(scene, points, closed, id, color) {
  "Append a run of vertices joined in order, closed back to the first if asked: the stroke every box, axis, path and arrow is drawn with.";
  base = scene.vertex_count;
  scene = u:rs_scene_vertices(scene, points)?;
  k = take(shape(points), 0, 0);
  if lt(k, 2) {
    err({kind: "rosetta_scene", message: "a polyline needs at least two points"})
  } else {
    from = range(k - 1) + base;
    flat = flatten(transpose(reshape(concat(from, from + 1), [2, k - 1])));
    flat = if closed {
      concat(flat, [base + k - 1, base])
    } else {
      flat
    };
    u:rs_scene_edges(scene, reshape(flat, [len(flat) / 2, 2]), id, color)
  }
}

def u:rs_scene_label(scene, point, id, text) {
  "Anchor a text label at a finite point, carrying a symbol id. The projector draws the text; the scene only says what and where.";
  if 1 - (eq(rank(point), 1) * eq(len(point), 3) * u:rs_finite(point)) {
    err({kind: "rosetta_scene", message: "a label anchor must be three finite numbers"})
  } else {
    if 1 - (u:rs_id_valid(id) * gt(str_len(text), 0) * eq(str_find(text, "|"), -1)) {
      err({kind: "rosetta_scene", message: str_concat("invalid label id or text: ", id)})
    } else {
      n = scene.label_count;
      ok(u:rs_scene_with(scene, scene.vertex_count, scene.positions, scene.edge_count, scene.edges, scene.edge_ids, scene.edge_colors, n + 1, u:rs_delimited_append(scene.label_ids, n, id), u:rs_delimited_append(scene.label_texts, n, text), concat(scene.label_positions, point), scene.frame_count, scene.frames))
    }
  }
}

def u:rs_scene_frame(scene, positions) {
  "Append one frame: a complete [vertex_count, 3] array of finite positions for one step of the axis. Edges, ids, colors and labels are the same in every frame; only vertices move.";
  if 1 - (eq(rank(positions), 2) * eq(u:rs_dim(positions, 0), scene.vertex_count) * eq(u:rs_dim(positions, 1), 3)) {
    err({kind: "rosetta_scene", message: "a frame must hold one position per vertex"})
  } else {
    if 1 - u:rs_finite(positions) {
      err({kind: "rosetta_scene", message: "a frame position is not finite"})
    } else {
      ok(u:rs_scene_with(scene, scene.vertex_count, scene.positions, scene.edge_count, scene.edges, scene.edge_ids, scene.edge_colors, scene.label_count, scene.label_ids, scene.label_texts, scene.label_positions, scene.frame_count + 1, concat(scene.frames, flatten(positions))))
    }
  }
}

def u:rs_scene_validate(scene) {
  "A scene is complete when it has vertices and edges (every edge built through this module is already in range) and its frames, if any, cover every vertex.";
  if eq(scene.vertex_count, 0) + eq(scene.edge_count, 0) {
    err({kind: "rosetta_scene", message: "a scene needs vertices and edges"})
  } else {
    if 1 - eq(len(scene.frames), scene.frame_count * scene.vertex_count * 3) {
      err({kind: "rosetta_scene", message: "frames do not cover every vertex"})
    } else {
      ok(1)
    }
  }
}

def u:rs_scene_export(scene, places) {
  "The validated scene as the line-scene record for JSON, positions rounded to places decimals: positions and edges with a controls record as the native viewer expects, plus ids and colors per edge, labels, and frames along the axis.";
  u:rs_scene_validate(scene)?;
  n = scene.vertex_count;
  m = scene.edge_count;
  ok({schema: scene.schema, version: scene.version, positions: u:rs_array_json(u:rs_round(reshape(scene.positions, [n, 3]), places)), edges: u:rs_array_json(reshape(scene.edges, [m, 2])), controls: {rotation_speed: 0, line_color: [0.8, 0.8, 0.85, 1], line_thickness: 2}, ids: str_split(scene.edge_ids, "|"), colors: u:rs_array_json(reshape(scene.edge_colors, [m, 4])), labels: {count: scene.label_count, ids: str_split(scene.label_ids, "|"), texts: str_split(scene.label_texts, "|"), positions: u:rs_array_json(u:rs_round(reshape(scene.label_positions, [scene.label_count, 3]), places))}, frames: {axis: scene.axis, count: scene.frame_count, positions: u:rs_array_json(u:rs_round(reshape(scene.frames, [scene.frame_count, n, 3]), places))}})
}
