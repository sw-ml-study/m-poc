# Build the Visual face of the sigmoid neuron from the committed trace and write it: fixtures/sigmoid/scene.json by default, or the path given as the script's argument (scripts/check-fixtures uses that). The JSON written is also printed; the reg-rs baseline rosetta_sigmoid_scene pins it.
include "visual.mlpl";

sg_path = if gt(list_len(args()), 0) {
  unwrap(list_get(args(), 0))
} else {
  "fixtures/sigmoid/scene.json"
};

trace = unwrap(u:sg_read_trace("fixtures/sigmoid/trace.json"));
scene = unwrap(u:sg_scene(trace));
text = unwrap(u:rs_write_json(sg_path, unwrap(u:rs_scene_export(scene, 4))));
print(text);
str_concat("wrote ", sg_path)
