# The Visual face of feature normalization, as a line scene built from the trace. Left, three independent lanes, one per position: the feature and its mean into −, then ÷ the spread, into z, with the lane being computed lit and each z cell holding a bar once computed. Right, the index-space panel: each position maps to its triple (x, μ, σ), the one rule f is applied, and z comes out; the lanes never touch, which is what makes the computation applicative. Every edge and label carries a symbol id of the equation record. Coordinates are scene units, roughly 17 wide by 9 high.
include "../../lib/rosetta/scene.mlpl";
include "equation.mlpl";

def u:fn_palette() {
  "The RGBA colours of the face.";
  {structure: [0.78, 0.8, 0.88, 1], input: [0.4, 0.85, 0.95, 1], param: [0.95, 0.85, 0.4, 1], output: [0.72, 0.58, 0.95, 1], flow: [0.55, 0.58, 0.68, 1], lit: [1, 0.6, 0.25, 1]}
}

def u:fn_lane_y(k) {
  "Scene y of lane k.";
  7.4 - k * 2.2
}

def u:fn_lane(scene, trace, k, t) {
  "One lane: x_k and μ_k into −, ÷ σ_k, into z_k; the z cell holds a bar once position k has been computed.";
  c = u:fn_palette();
  y = u:fn_lane_y(k);
  x = take(trace.constants.x, 0, k);
  mu = take(trace.constants.mu, 0, k);
  sg = take(trace.constants.sigma, 0, k);
  z = take(take(reshape(trace.channels.z.values, trace.channels.z.shape), 0, t), 0, k);
  scene = u:rs_scene_box(scene, 1.0, y + 0.45, 1.1, 0.6, "x", to_string(x), c.input)?;
  scene = u:rs_scene_box(scene, 1.0, y - 0.45, 1.1, 0.6, "mu", to_string(mu), c.param)?;
  scene = u:rs_scene_box(scene, 2.9, y, 0.8, 0.6, "sub", "−", c.structure)?;
  scene = u:rs_scene_box(scene, 4.6, y - 0.75, 1.1, 0.6, "sigma", to_string(sg), c.param)?;
  scene = u:rs_scene_box(scene, 4.6, y, 0.8, 0.6, "div", "÷", c.structure)?;
  scene = u:rs_scene_rect(scene, 6.1, y - 0.35, 7.7, y + 0.35, "z", c.output)?;
  scene = u:rs_scene_label(scene, [8.1, y, 0], "z", "z")?;
  scene = u:rs_scene_segment(scene, 1.55, y + 0.45, 2.5, y + 0.1, "x", c.flow)?;
  scene = u:rs_scene_segment(scene, 1.55, y - 0.45, 2.5, y - 0.1, "mu", c.flow)?;
  scene = u:rs_scene_segment(scene, 3.3, y, 4.2, y, "sub", c.flow)?;
  scene = u:rs_scene_segment(scene, 4.6, y - 0.45, 4.6, y - 0.3, "sigma", c.flow)?;
  scene = u:rs_scene_segment(scene, 5.0, y, 6.1, y, "div", c.flow)?;
  unit = 0.75 / (reduce(:max, abs(trace.channels.div)) + 0.0001);
  scene = u:rs_scene_segment(scene, 6.9, y - 0.12, 6.9 + z * unit, y - 0.12, "z", c.output)?;
  scene = u:rs_scene_segment(scene, 6.9, y + 0.12, 6.9 + z * unit, y + 0.12, "z", c.output)?;
  half = if eq(k, take(trace.channels.i, 0, t)) {
    1
  } else {
    0
  };
  u:rs_scene_rect(scene, 0.35 - half * 0.1, y - 1.0 * half, 8.5 * half + 0.35 * (1 - half), y + 1.0 * half, "i", c.lit)
}

def u:fn_index_panel(scene, trace, t) {
  "The applicative view: index ──▶ triple ──f──▶ z, one row per position, the current one lit.";
  c = u:fn_palette();
  scene = u:rs_scene_label(scene, [10.2, 8.9, 0], "Fin", "Fin(3)")?;
  scene = u:rs_scene_label(scene, [12.6, 8.9, 0], "tuple", "(x, μ, σ)")?;
  scene = u:rs_scene_label(scene, [16.0, 8.9, 0], "z", "z")?;
  k = 0;
  while lt(k, 3) {
    y = u:fn_lane_y(k);
    scene = u:rs_scene_box(scene, 10.2, y, 0.7, 0.6, "i", to_string(k), c.structure)?;
    scene = u:rs_scene_segment(scene, 10.6, y, 11.4, y, "in", c.flow)?;
    scene = u:rs_scene_box(scene, 12.6, y, 2.2, 0.6, "tuple", str_concat(str_concat(str_concat(str_concat(to_string(take(trace.constants.x, 0, k)), ", "), to_string(take(trace.constants.mu, 0, k))), ", "), to_string(take(trace.constants.sigma, 0, k))), c.param)?;
    scene = u:rs_scene_segment(scene, 13.75, y, 14.3, y, "div", c.flow)?;
    scene = u:rs_scene_box(scene, 14.7, y, 0.7, 0.6, "div", "f", c.structure)?;
    scene = u:rs_scene_segment(scene, 15.1, y, 15.6, y, "div", c.flow)?;
    scene = u:rs_scene_diamond(scene, 16.0, y, 0.16, "z", c.output)?;
    k = k + 1
  };
  ok(scene)
}

def u:fn_panels(scene) {
  "Name the two panels for the page's legend and callouts.";
  c = u:fn_palette();
  scene = u:rs_scene_panel(scene, "lanes", "Lanes", "One lane per position: the feature x and its mean μ meet at −, the difference is divided by the spread σ, and z comes out as a bar in its cell. The lane being computed is outlined; the other two do not change when it runs, because no lane depends on another.", [0.2, 2.0, 8.6, 8.6], c.output)?;
  u:rs_scene_panel(scene, "index", "Index space", "The applicative view: each position of Fin(3) maps to its triple (x, μ, σ), the same rule f is applied, and a z results. A fixed 3-tuple is the same thing as a function from these three positions to numbers; that is what the tuple line on the M face declares, and why the work can run pointwise with nothing summed.", [9.6, 2.0, 16.6, 9.3], c.param)
}

def u:fn_visual(trace, t) {
  "The whole Visual face at step t of a parsed trace record.";
  scene = u:rs_scene_new(trace.axis.name);
  k = 0;
  while lt(k, 3) {
    scene = u:fn_lane(scene, trace, k, t)?;
    k = k + 1
  };
  scene = u:fn_index_panel(scene, trace, t)?;
  u:fn_panels(scene)
}

def u:fn_scene(trace) {
  "The Visual face with one frame per position.";
  scene = u:fn_visual(trace, 0)?;
  t = 0;
  while lt(t, trace.axis.count) {
    frame = u:fn_visual(trace, t)?;
    scene = u:rs_scene_frame(scene, reshape(frame.positions, [frame.vertex_count, 3]))?;
    t = t + 1
  };
  ok(scene)
}

def u:fn_read_trace(path) {
  "The trace record from its fixture.";
  parse_json(read_text(path)?)
}
