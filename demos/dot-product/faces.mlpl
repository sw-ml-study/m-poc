# Render the dot product's Math and proposed-M faces to SVG and write them, with the equation record as JSON: fixtures/dot-product/faces/ by default, or the directory given as the script's argument. Both documents are also printed; the reg-rs baseline rosetta_dot_product_faces pins them.
include "../../lib/rosetta/faces.mlpl";
include "../../lib/rosetta/emit.mlpl";
include "equation.mlpl";

dp_dir = if gt(list_len(args()), 0) {
  unwrap(list_get(args(), 0))
} else {
  "fixtures/dot-product/faces"
};

ir = unwrap(u:dp_equation());
unwrap(make_dir(dp_dir));
math = unwrap(u:rs_face_svg(ir, "math"));
m = unwrap(u:rs_face_svg(ir, "m"));
unwrap(write_atomic(str_concat(dp_dir, "/math.svg"), math));
unwrap(write_atomic(str_concat(dp_dir, "/m.svg"), m));
unwrap(u:rs_write_json(str_concat(dp_dir, "/equation.json"), unwrap(u:rs_ir_export(ir))));
print("MATH");
print(math);
print("M (proposed)");
print(m);
str_concat("wrote ", dp_dir)
