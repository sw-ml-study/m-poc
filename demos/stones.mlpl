# The manifest of stones for the page: every equation record's id, title and one-line purpose, and a hint of face widths (scene units) so the stone's cross-section suits each stone's content. Written to fixtures/stones.json by default, or to the path given as the script's argument; printed too, for the reg-rs baseline rosetta_stones. Add a stone by including its equation and appending it below.
include "../lib/rosetta/emit.mlpl";
include "one-neuron/equation.mlpl";
include "dot-product/equation.mlpl";
include "matmul/equation.mlpl";
include "softmax/equation.mlpl";
include "cnn/equation.mlpl";

def u:stones_manifest() {
  "The manifest record: parallel lists, one entry per stone, in tour order.";
  neuron = u:on_equation()?;
  dot = u:dp_equation()?;
  mm = u:mm_equation()?;
  sm = u:sm_equation()?;
  cn = u:cn_equation()?;
  ok({schema: "sw-ml-study.rosetta.stones", version: 1, ids: [neuron.name, dot.name, mm.name, sm.name, cn.name], titles: [neuron.title, dot.title, mm.title, sm.title, cn.title], purposes: [neuron.description, dot.description, mm.description, sm.description, cn.description], widths: {math: [480, 480, 480, 520, 720], m: [480, 480, 480, 480, 600], visual: [720, 720, 720, 720, 780]}})
}

st_path = if gt(list_len(args()), 0) {
  unwrap(list_get(args(), 0))
} else {
  "fixtures/stones.json"
};

text = unwrap(u:rs_write_json(st_path, unwrap(u:stones_manifest())));
print(text);
str_concat("wrote ", st_path)
