#!/bin/sh
# The full pre-commit gate. Grows one line per step as the plan lands.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

sh -n "$repo_root"/scripts/*
"$repo_root/scripts/check-structure"
"$repo_root/scripts/check-gitignore"
"$repo_root/scripts/check-abstraction"
"$repo_root/scripts/check-doc-links"
"$repo_root/scripts/check-mlpl-style"
"$repo_root/scripts/run-tests"
"$repo_root/scripts/run-reg"
git -C "$repo_root" diff --check

echo "PASS pre-commit"
