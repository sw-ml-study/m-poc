# Build the Visual face of image normalization from the committed trace and write it: fixtures/image-normalization/scene.json by default, or the path given as the script's argument. The JSON written is also printed; the reg-rs baseline rosetta_image_normalization_scene pins it.
include "visual.mlpl";

in_path = if gt(list_len(args()), 0) {
  unwrap(list_get(args(), 0))
} else {
  "fixtures/image-normalization/scene.json"
};

trace = unwrap(u:in_read_trace("fixtures/image-normalization/trace.json"));
scene = unwrap(u:in_scene(trace));
text = unwrap(u:rs_write_json(in_path, unwrap(u:rs_scene_export(scene, 4))));
print(text);
str_concat("wrote ", in_path)
