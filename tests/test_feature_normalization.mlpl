# The feature-normalization stone: z equals (x − mean) / std pointwise, each step fills one position and touches no other, the trace is keyed by the record's symbols, the record documents both readings (array and tuple), the Visual face's ids are symbols, and the committed fixtures are what the programs emit.
include "lib/rosetta/faces.mlpl";
include "demos/feature-normalization/fn.mlpl";
include "demos/feature-normalization/visual.mlpl";

def u:t_fn_unknown(ir, ids) {
  "The first id in a string list that is not a symbol of the record, or the empty string.";
  index = 0;
  unknown = "";
  while lt(index, list_len(ids)) {
    id = unwrap(list_get(ids, index));
    if eq(u:rs_ir_symbol_index(ir, id), -1) {
      unknown = id
    };
    index = index + 1
  };
  unknown
}

@test {name: "normalization is pointwise: each step fills one position and leaves the others as they were", tags: ["feature-normalization", "trace"]}
def u:test_fn_pointwise() {
  "The applicative property, checked on the rows: position t's value is (x_t − μ_t)/σ_t and no other position changes when it is computed.";
  rows = u:fn_steps();
  by_hand = [(120 - 123) / 58, (80 - 117) / 57, (200 - 104) / 57];
  u:assert_lt(reduce(:max, abs(rows.z - by_hand)), 0.000000001, "z by hand")?;
  u:assert_lt(reduce(:max, abs(rows.quot - by_hand)), 0.000000001, "the quotient at each step is that position's z")?;
  u:assert_eq(take(rows.filled, 0, 0), [take(by_hand, 0, 0), 0, 0], "after step 0 only position 0 is filled")?;
  u:assert_eq(take(rows.filled, 0, 1) - take(rows.filled, 0, 0), [0, take(by_hand, 0, 1), 0], "step 1 changes only position 1")?;
  u:assert_lt(abs(take(rows.z, 0, 2) - 1.684211), 0.00001, "the third feature is 1.68 spreads above its mean")
}

@test {name: "the trace is keyed by the record's symbols; both faces document the two readings; fixtures are fresh", tags: ["feature-normalization", "docs", "fixture"]}
def u:test_fn_record() {
  "Twenty symbols; the Math face has the index space, the M face has the tuple declaration; Fin and Tuple live on one face each.";
  ir = unwrap(u:fn_equation());
  u:assert_text_eq(ir.title, "Feature normalization", "title")?;
  u:assert_text_eq(u:rs_ir_undocumented(ir), "", "every symbol")?;
  u:assert_text_eq(u:rs_ir_undocumented_line(ir), "", "every line")?;
  u:assert_text_eq(u:rs_ir_undocumented_face(ir), "", "every face")?;
  u:assert_text_eq(u:rs_ir_math_text(ir), "z_{i} = (x_{i} − μ_{i}) / σ_{i}\ni ∈ Fin(3)", "math source")?;
  u:assert_text_eq(u:rs_ir_m_text(ir), "Z ← (X − Μ) ÷ Σ\nX Μ Σ Z : Tuple[3]", "m text: the array reading, then the tuple reading")?;
  u:assert_eq(u:rs_face_uses(ir.faces.m, "Fin") + u:rs_face_uses(ir.faces.math, "tuple"), 0, "Fin is paper vocabulary, Tuple is the notation's")?;
  trace = u:fn_trace(u:fn_steps(), 6);
  u:assert_text_eq(u:t_fn_unknown(ir, record_keys(trace.channels)), "", "channel keys are symbols")?;
  u:assert_text_eq(u:t_fn_unknown(ir, record_keys(trace.constants)), "", "constant keys are symbols")?;
  u:assert_eq(str_eq(read_text("fixtures/feature-normalization/trace.json")?, unwrap(u:rs_json(trace))), 1, "trace fresh")?;
  u:assert_eq(str_eq(read_text("fixtures/feature-normalization/faces/math.svg")?, unwrap(u:rs_face_svg(ir, "math"))), 1, "math.svg fresh")?;
  parsed = unwrap(u:fn_read_trace("fixtures/feature-normalization/trace.json"));
  out = unwrap(u:rs_scene_export(unwrap(u:fn_visual(parsed, 1)), 4));
  u:assert_text_eq(u:t_fn_unknown(ir, out.ids), "", "edge ids are symbols")?;
  u:assert_text_eq(u:t_fn_unknown(ir, out.labels.ids), "", "label ids are symbols")?;
  u:assert_eq(out.panels.count, 2, "two panels")?;
  full = unwrap(u:rs_scene_export(unwrap(u:fn_scene(parsed)), 4));
  u:assert_eq(full.frames.count, 3, "one frame per position")?;
  u:assert_eq(str_eq(read_text("fixtures/feature-normalization/scene.json")?, unwrap(u:rs_json(full))), 1, "scene.json fresh")
}

u:run_registered_tests()
